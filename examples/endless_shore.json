        "profile": [[-55, -3.2], [-30, -1.3], [-12, -0.4], [-2, 0.04], [12, 0.9], [30, 2.2], [52, 4.0], [75, 7.5]],
        "noise": { "amplitude": 0.75, "wavelength": [26, 44], "octaves": 3, "seed": 5, "fade_x": [-14, 8] }
      },
      "palette": [[-3.2, "#33505c"], [-0.5, "#8b7a5e"], [0.12, "#b39c76"], [0.7, "#e6d2a6"], [3.0, "#d8c38f"], [5.5, "#8a9a58"]],
      "grain": 0.06,
      "material": { "roughness": 0.95 }
