{
  "notes": "Top-down switch-and-objective game for the custom-client example (`red_engine2 describe custom-client`). All gameplay is the rules below, run by the engine's MatchSim; the client only moves the player and draws.",
  "camera": { "fov": 45, "position": [0, 14, 4.5], "target": [0, 0, -1] },
  "background": { "sky_top": "#27313f", "sky_bottom": "#4b5a6b" },
  "ambient": { "color": "#ffffff", "intensity": 0.35 },
  "lights": [
    { "id": "sun", "type": "directional", "direction": [-0.4, -1, -0.3], "color": "#fff4e0", "intensity": 2.6, "cast_shadows": true, "shadow_radius": 12, "shadow_center": [0, 0, -1] }
  ],
  "spawns": [ { "id": "start", "position": [0, 0, 4.5], "yaw_deg": 0 } ],
  "zones": [ { "id": "exit_zone", "rect": [-1, -6.5, 1, -4.5] } ],
  "vars": { "switches": 0, "gate_open": false },
  "rules": [
    { "id": "lamps_start_off", "when": { "start": true }, "do": [ { "hide": "lamp_a_on" }, { "hide": "lamp_b_on" } ] },
    { "id": "press_a", "when": { "enter": { "object": "switch_a", "pad": 0.1 } }, "once": true,
      "do": [ { "add": ["switches", 1] }, { "hide": "lamp_a_off" }, { "show": "lamp_a_on" }, { "emit": "switch" } ] },
    { "id": "press_b", "when": { "enter": { "object": "switch_b", "pad": 0.1 } }, "once": true,
      "do": [ { "add": ["switches", 1] }, { "hide": "lamp_b_off" }, { "show": "lamp_b_on" }, { "emit": "switch" } ] },
    { "id": "open_gate", "when": { "event": "switch" }, "if": "switches >= 2", "once": true,
      "do": [ { "set": ["gate_open", true] }, { "hide": "gate" }, { "collision": ["gate", false] }, { "emit": "gate_open" } ] },
    { "id": "escape", "when": { "enter": { "zone": "exit_zone" } }, "if": "gate_open", "do": [ { "end": "escaped" } ] }
  ],
  "objects": [
    { "id": "floor", "type": "box", "size": [16, 0.2, 14], "position": [0, -0.1, -1], "material": { "color": "#5d6670", "roughness": 0.9 } },
    { "id": "wall_n", "type": "box", "size": [16.3, 1, 0.3], "position": [0, 0.5, -8], "material": { "color": "#c9c2b4" } },
    { "id": "wall_s", "type": "box", "size": [16.3, 1, 0.3], "position": [0, 0.5, 6], "material": { "color": "#c9c2b4" } },
    { "id": "wall_w", "type": "box", "size": [0.3, 1, 14], "position": [-8, 0.5, -1], "material": { "color": "#c9c2b4" } },
    { "id": "wall_e", "type": "box", "size": [0.3, 1, 14], "position": [8, 0.5, -1], "material": { "color": "#c9c2b4" } },
    { "id": "divider_w", "type": "box", "size": [7, 1, 0.3], "position": [-4.5, 0.5, -2], "material": { "color": "#a9a293" } },
    { "id": "divider_e", "type": "box", "size": [7, 1, 0.3], "position": [4.5, 0.5, -2], "material": { "color": "#a9a293" } },
    { "id": "gate", "type": "box", "size": [2, 1.2, 0.3], "position": [0, 0.6, -2], "material": { "color": "#d8322a", "emissive": "#3a0806" } },
    { "id": "switch_a", "type": "box", "size": [1.2, 0.06, 1.2], "position": [-5, 0.03, 2.5], "collide": false, "material": { "color": "#3b82f6", "emissive": "#0a1e40" } },
    { "id": "switch_b", "type": "box", "size": [1.2, 0.06, 1.2], "position": [5, 0.03, 2.5], "collide": false, "material": { "color": "#3b82f6", "emissive": "#0a1e40" } },
    { "id": "lamp_a_off", "type": "cylinder", "radius": 0.18, "height": 0.9, "position": [-6.4, 0.45, 2.5], "collide": false, "material": { "color": "#7a1d18" } },
    { "id": "lamp_a_on", "type": "cylinder", "radius": 0.18, "height": 0.9, "position": [-6.4, 0.45, 2.5], "collide": false, "material": { "color": "#2fd35a", "emissive": "#1f8a3a" } },
    { "id": "lamp_b_off", "type": "cylinder", "radius": 0.18, "height": 0.9, "position": [6.4, 0.45, 2.5], "collide": false, "material": { "color": "#7a1d18" } },
    { "id": "lamp_b_on", "type": "cylinder", "radius": 0.18, "height": 0.9, "position": [6.4, 0.45, 2.5], "collide": false, "material": { "color": "#2fd35a", "emissive": "#1f8a3a" } },
    { "id": "exit", "type": "box", "size": [2, 0.06, 2], "position": [0, 0.03, -5.5], "collide": false, "material": { "color": "#f2c230", "emissive": "#5a4308" } },
    { "id": "player", "type": "group", "position": [0, 0, 4.5], "collide": false, "children": [
      { "id": "body", "type": "cylinder", "radius": 0.35, "height": 1.1, "position": [0, 0.55, 0], "material": { "color": "#f5f5f5" } },
      { "id": "head", "type": "sphere", "radius": 0.24, "position": [0, 1.32, 0], "material": { "color": "#f5f5f5" } },
      { "id": "nose", "type": "box", "size": [0.16, 0.16, 0.3], "position": [0, 1.3, 0.28], "material": { "color": "#ff8a1e" } } ] }
  ],
  "checks": {
    "sim": [
      { "name": "both switches open the gate, then the exit wins",
        "players": [ { "id": "p1", "character": "human", "spawn": "start" } ],
        "script": [ { "player": "p1", "walk": "0,4.5; -5,2.5; 5,2.5; 0,1; 0,-5.5" } ],
        "expect": [ { "event": "switch", "count": 2 }, { "event": "gate_open", "count": 1 }, { "var": "gate_open", "eq": true },
                    { "hidden": "gate" }, { "ended": "escaped" } ] },
      { "name": "the closed gate blocks a player who skips the switches",
        "players": [ { "id": "p1", "character": "human", "spawn": "start" } ],
        "script": [ { "player": "p1", "hold": { "forward": 1, "yaw_deg": 0, "seconds": 3 } } ],
        "expect": [ { "no_event": "gate_open" }, { "player": "p1", "near": [0, -1.5], "tol": 0.4 } ] }
    ]
  }
}
