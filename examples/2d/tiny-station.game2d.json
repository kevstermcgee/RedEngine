        "do": [{"apply": "toggle_pause"}]
      }
    },
    {
      "button": {
        "id": "music",
        "label": "MUSIC",
        "at": [428, 248],
        "size": [44, 16],
        "key": "KeyM",
        "color": "#2d3f73",
        "do": [{"music": "toggle"}]
      }
    },
    {"text": "OFF", "at": [420, 252], "color": "#ff7a8c", "scale": 1, "align": "right", "show": "!music_on"}
  ],
  "effects": {
    "build": {
      "about": "buy a module on the clicked plot: spend `cost` credits, put `prefab` there, and show it",
      "params": ["cost", "prefab"],
      "do": [
        {"add": ["credits", "-$cost"]}, {"spawn": {"prefab": "$prefab", "at": "self"}}, {"play": "build"},
        {"burst": {"at": "self", "n": 12, "color": "#9fd2ff", "speed": [20, 60], "life": [0.2, 0.5]}},
        {"destroy": "self"}
      ]
    },
    "toggle_pause": {"about": "the pause key and the PAUSE button do the same thing", "do": [{"set": ["paused", "1 - paused"]}, {"play": "select"}]}
  },
  "rules": [
    {
      "id": "no funds",
      "when": {"click": "slot"},
      "if": "(tool == 1 && credits < 40) || (tool == 2 && credits < 50) || (tool == 3 && credits < 45) || (tool == 4 && credits < 60) || (tool == 5 && credits < 70) || (tool == 6 && credits < 90) ",
      "do": [{"play": "nofunds"}, {"set": ["warn", 2]}]
    },
    {"id": "no tool", "when": {"click": "slot"}, "if": "tool == 0", "do": [{"set": ["hint", 2.5]}]},
    {
      "id": "build solar",
      "when": {"click": "slot"},
      "if": "tool == 1 && credits >= 40 && ended == 0",
      "do": [{"apply": "build", "with": {"cost": 40, "prefab": "solar"}}]
    },
    {
      "id": "build oxygenator",
      "when": {"click": "slot"},
      "if": "tool == 2 && credits >= 50 && ended == 0",
      "do": [{"apply": "build", "with": {"cost": 50, "prefab": "oxygenator"}}]
    },
    {
      "id": "build hydroponics",
      "when": {"click": "slot"},
      "if": "tool == 3 && credits >= 45 && ended == 0",
      "do": [{"apply": "build", "with": {"cost": 45, "prefab": "hydroponics"}}]
    },
    {
      "id": "build quarters",
      "when": {"click": "slot"},
      "if": "tool == 4 && credits >= 60 && ended == 0",
      "do": [{"apply": "build", "with": {"cost": 60, "prefab": "quarters"}}]
    },
    {
      "id": "build lab",
      "when": {"click": "slot"},
      "if": "tool == 5 && credits >= 70 && ended == 0",
      "do": [{"apply": "build", "with": {"cost": 70, "prefab": "lab"}}]
    },
    {
      "id": "build shield",
      "when": {"click": "slot"},
      "if": "tool == 6 && credits >= 90 && ended == 0",
      "do": [{"apply": "build", "with": {"cost": 90, "prefab": "shield"}}]
    },
    {
      "id": "economy",
      "when": {"every": 1},
      "if": "paused == 0 && ended == 0",
      "do": [
        {
          "add": [
            "power",
            "3 * count_solar - 2 * count_oxygenator - 2 * count_hydroponics - 3 * count_lab - 1 * count_quarters - 2 * count_shield"
          ]
        },
        {"add": ["air", "(power > 0) * 2.6 * count_oxygenator - 0.5 * crew"]},
        {"add": ["food", "(power > 0) * 1.7 * count_hydroponics - 0.4 * crew"]},
        {"add": ["credits", "(power > 0) * 2.2 * count_lab + 0.3 * crew"]}
      ]
    },
    {"id": "power floor", "when": {"every": 0.25}, "if": "power < 0", "do": [{"set": ["power", 0]}]},
    {"id": "power ceiling", "when": {"every": 0.25}, "if": "power > 100", "do": [{"set": ["power", 100]}]},
    {"id": "air floor", "when": {"every": 0.25}, "if": "air < 0", "do": [{"set": ["air", 0]}]},
    {"id": "air ceiling", "when": {"every": 0.25}, "if": "air > 100", "do": [{"set": ["air", 100]}]},
    {"id": "food floor", "when": {"every": 0.25}, "if": "food < 0", "do": [{"set": ["food", 0]}]},
    {"id": "food ceiling", "when": {"every": 0.25}, "if": "food > 100", "do": [{"set": ["food", 100]}]},
    {
      "id": "low alarm",
      "when": {"every": 6},
      "if": "(power < 15 || air < 20 || food < 20) && paused == 0 && ended == 0",
      "do": [{"play": "alarm"}]
    },
    {
      "id": "crew arrives",
      "when": {"every": 12},
      "if": "crew < 2 + 2 * count_quarters && food > 25 && air > 25 && power > 0 && paused == 0 && ended == 0",
      "do": [{"add": ["crew", 1]}, {"play": "crew"}]
    },
    {
      "id": "crew suffers",
      "when": {"every": 5},
      "if": "(air < 3 || food < 3) && crew > 0 && paused == 0 && ended == 0",
      "do": [{"add": ["crew", -1]}, {"play": "alarm"}, {"shake": 3}]
    },
    {"id": "station lost", "when": {"every": 0.25}, "if": "crew <= 0 && ended == 0", "do": [{"end": "lose"}]},
    {
      "id": "a day passes",
      "when": {"every": 45},
      "if": "paused == 0 && ended == 0",
      "do": [{"add": ["day", 1]}, {"play": "day"}]
    },
    {"id": "survived", "when": {"every": 0.25}, "if": "day > 10 && ended == 0", "do": [{"end": "win"}]},
    {
      "id": "supply drop",
      "when": {"every": 38},
      "if": "paused == 0 && ended == 0",
      "do": [{"add": ["credits", 25]}, {"play": "select"}]
    },
    {
      "id": "meteor late",
      "when": {"every": 17},
      "if": "paused == 0 && ended == 0 && day >= 8",
      "do": [{"spawn": {"prefab": "meteor", "at": {"x": [44, 250], "y": [-10, -8]}, "vel": [0, 80]}}]
    },
    {
      "id": "meteor",
      "when": {"every": 26},
      "if": "paused == 0 && ended == 0 && day >= 4",
      "do": [{"spawn": {"prefab": "meteor", "at": {"x": [44, 250], "y": [-10, -8]}, "vel": [0, 70]}}]
    },
    {
      "id": "meteor hits module",
      "when": {"touch": ["meteor", "module"]},
      "if": "count_shield == 0",
      "do": [
        {"spawn": {"prefab": "slot", "at": "other"}}, {"destroy": "other"}, {"destroy": "self"}, {"play": "boom"},
        {"shake": 6}, {"burst": {"at": "self", "n": 26, "color": "#ff9a3d", "speed": [30, 110], "life": [0.3, 0.8]}},
        {"add": ["losses", 1]}, {"emit": "module lost"}
      ]
    },
    {
      "id": "shield stops meteor",
      "when": {"touch": ["meteor", "module"]},
      "if": "count_shield > 0",
      "do": [
        {"destroy": "self"}, {"play": "shield"},
        {"burst": {"at": "self", "n": 18, "color": "#7fd1ff", "speed": [30, 90], "life": [0.2, 0.6]}}
      ]
    },
    {"id": "warn fades", "when": {"every": 0.25}, "if": "warn > 0", "do": [{"add": ["warn", -0.25]}]},
    {"id": "hint fades", "when": {"every": 0.25}, "if": "hint > 0", "do": [{"add": ["hint", -0.25]}]},
    {
      "id": "solar flare",
      "when": {"every": 100},
      "if": "paused == 0 && ended == 0",
      "do": [{"set": ["power", "power * 0.4"]}, {"set": ["flare", 3]}, {"play": "alarm"}, {"shake": 3}]
    },
    {"id": "flare fades", "when": {"every": 0.25}, "if": "flare > 0", "do": [{"add": ["flare", -0.25]}]},
    {"id": "pause key", "when": {"press": "pause"}, "do": [{"apply": "toggle_pause"}]},
    {
      "id": "score on end",
      "when": {"end": "any"},
      "do": [{"set": ["score", "crew * 25 + credits / 4 + (day - 1) * 10"]}]
    },
    {"id": "record", "when": {"end": "any"}, "if": "score > best", "do": [{"set": ["best", "score"]}]},
    {"id": "win jingle", "when": {"end": "win"}, "do": [{"play": "win"}]},
    {"id": "lose jingle", "when": {"end": "lose"}, "do": [{"play": "lose"}]}
  ],
  "checks": {
    "scenarios": [
      {
        "name": "a balanced station survives all ten days",
        "seed": 3,
        "max_seconds": 600,
        "smoke": true,
        "script": [
          {"wait_until": {"var": "credits", "gte": 45}, "timeout": 240}, {"button": "tool hydroponics"},
          {"click": [128, 92]}, {"wait_until": {"var": "credits", "gte": 40}, "timeout": 240},
          {"button": "tool solar"}, {"click": [164, 92]},
          {"wait_until": {"var": "credits", "gte": 40}, "timeout": 240}, {"button": "tool solar"},
          {"click": [200, 92]}, {"wait_until": {"var": "credits", "gte": 90}, "timeout": 240},
          {"button": "tool shield"}, {"click": [236, 92]},
          {"wait_until": {"var": "credits", "gte": 70}, "timeout": 240}, {"button": "tool lab"}, {"click": [92, 128]},
          {"wait_until": {"var": "credits", "gte": 40}, "timeout": 240}, {"button": "tool solar"},
          {"click": [128, 128]}, {"wait_until": {"ended": "win"}, "timeout": 500}
        ],
        "expect": [
          {"ended": "win"}, {"var": "day", "gte": 11}, {"var": "crew", "gte": 2}, {"var": "score", "gt": 0},
          {"var": "best", "gt": 0}, {"sound": "build", "min": 5}, {"sound": "win"}, {"sound": "shield", "min": 1},
          {"var": "losses", "eq": 0}
        ]
      },
      {
        "name": "doing nothing starves the crew and the station is lost",
        "seed": 3,
        "max_seconds": 400,
        "script": [{"wait_until": {"ended": "lose"}, "timeout": 390}],
        "expect": [{"ended": "lose"}, {"var": "crew", "eq": 0}, {"sound": "lose"}, {"sound": "alarm", "min": 1}]
      },
      {
        "name": "building needs credits: a purchase is refused when broke",
        "seed": 3,
        "max_seconds": 30,
        "script": [{"button": "tool shield"}, {"click": [164, 128]}, {"click": [200, 128]}],
        "expect": [{"count": "shield", "eq": 0}, {"var": "credits", "eq": 80}, {"sound": "nofunds", "min": 2}]
      },
      {
        "name": "clicking a plot with no module chosen explains itself",
        "seed": 3,
        "max_seconds": 10,
        "script": [{"click": [56, 164]}, {"wait": 0.1}],
        "expect": [{"var": "hint", "gt": 0}, {"count": "module", "eq": 3}]
      },
      {
        "name": "a purchase turns a plot into the module and spends the credits",
        "seed": 3,
        "max_seconds": 20,
        "script": [{"button": "tool solar"}, {"click": [128, 92]}],
        "expect": [{"count": "solar", "eq": 2}, {"var": "credits", "eq": 40}, {"count": "slot", "eq": 20}, {"sound": "build"}]
      },
      {
        "name": "pausing freezes the clock and the economy",
        "seed": 3,
        "max_seconds": 80,
        "script": [{"press": "pause"}, {"wait": 60}],
        "expect": [{"var": "day", "eq": 1}, {"var": "paused", "eq": 1}, {"var": "air", "eq": 80}]
      },
      {
        "name": "a meteor destroys an unshielded module and leaves a free plot",
        "seed": 3,
        "max_seconds": 300,
        "script": [
          {"wait_until": {"var": "credits", "gte": 45}, "timeout": 240}, {"button": "tool hydroponics"},
          {"click": [128, 92]}, {"wait_until": {"var": "credits", "gte": 40}, "timeout": 240},
          {"button": "tool solar"}, {"click": [164, 92]}, {"wait_until": {"event": "module lost"}, "timeout": 250}
        ],
        "expect": [
          {"event": "module lost"}, {"var": "losses", "gte": 1}, {"sound": "boom"}, {"not_ended": true},
          {"count": "slot", "gte": 20}
        ]
      }
    ],
    "browser": [
      {"name": "choose a module and build it with the mouse", "click": [379, 106], "changes": ["tool"], "ms": 100},
      {"name": "the pause key stops time", "keys": ["KeyP"], "ms": 100, "changes": ["paused"]},
      {
        "name": "the music button turns music off and the choice survives a reload",
        "click": [450, 256],
        "changes": ["music_on"],
        "persists": ["music_on"]
      }
    ]
  }
}
