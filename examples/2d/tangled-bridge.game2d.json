     ]
    },
    {
     "play": "tada"
    }
   ]
  },
  {
   "id": "win",
   "when": {
    "every": 0.2
   },
   "if": "taught >= 4 && ended == 0",
   "do": [
    {
     "end": "win"
    }
   ]
  },
  {
   "id": "lose",
   "when": {
    "every": 0.2
   },
   "if": "time >= 80 && ended == 0",
   "do": [
    {
     "end": "lose"
    }
   ]
  },
  {
   "id": "best",
   "when": {
    "end": "win"
   },
   "if": "best == 0 || time < best",
   "do": [
    {
     "set": [
      "best",
      "floor(time)"
     ]
    }
   ]
  }
