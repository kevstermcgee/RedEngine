 "rules": [
  {
   "id": "chalkL",
   "when": {
    "click": "fL"
   },
   "do": [
    {
     "spawn": {
      "prefab": "cL",
      "at": "self"
     }
    },
    {
     "destroy": "self"
    },
    {
     "play": "chalk"
    }
   ]
  },
  {
   "id": "chalkR",
   "when": {
    "click": "fR"
   },
   "do": [
    {
     "spawn": {
      "prefab": "cR",
      "at": "self"
     }
    },
    {
     "destroy": "self"
    },
    {
     "play": "chalk"
    }
   ]
  },
  {
   "id": "tide",
   "when": {
    "every": 2
   },
   "if": "count_chalked > 0",
   "do": [
    {
     "add": [
      "broken",
      "count_chalked"
     ]
    },
    {
     "destroy": "tag:chalked"
    },
    {
     "play": "break"
    },
    {
     "shake": 3
    },
    {
     "set": [
      "wl",
      "4 + broken * 8"
     ]
    },
    {
     "set": [
      "wr",
      "316 - broken * 8"
     ]
    },
    {
     "teleport": {
      "target": "id:wallL",
      "to": [
       "wl",
       90
      ]
     }
    },
    {
     "teleport": {
      "target": "id:wallR",
      "to": [
       "wr",
       90
      ]
     }
    }
   ]
  },
  {
   "id": "crush",
   "when": {
    "touch": [
     "wall",
     "crate"
    ]
   },
   "do": [
    {
     "destroy": "other"
    },
    {
     "play": "zap"
    }
   ]
  },
  {
   "id": "drain",
   "when": {
    "every": 0.5
   },
   "do": [
    {
     "add": [
      "energy",
      "-(1 + broken * 1.5) * 0.5"
     ]
    }
   ]
  },
  {
   "id": "dead",
   "when": {
    "every": 0.1
   },
   "if": "energy <= 0",
   "do": [
    {
     "end": "lose"
    }
   ]
  },
  {
   "id": "surf",
   "when": {
    "event": "surface"
   },
   "if": "count_fL == count_fR && count_fL > 0",
   "do": [
    {
     "set": [
      "best",
      "energy"
     ]
    },
    {
     "end": "win"
    }
   ]
  },
  {
   "id": "surfbad",
   "when": {
    "event": "surface"
   },
   "if": "count_fL != count_fR || count_fL == 0",
   "do": [
    {
     "end": "lose"
    }
   ]
  },
  {
   "id": "w",
   "when": {
    "end": "win"
   },
   "do": [
    {
     "play": "win"
    }
   ]
  },
  {
   "id": "l",
   "when": {
    "end": "lose"
   },
   "do": [
    {
     "play": "lose"
    }
   ]
  }
 ],
