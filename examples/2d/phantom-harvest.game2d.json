 "rules": [
  {
   "id": "calc",
   "when": {
    "every": 0.016
   },
   "do": [
    {
     "set": [
      "nx",
      "0-(b_y-a_y)"
     ]
    },
    {
     "set": [
      "ny",
      "b_x-a_x"
     ]
    },
    {
     "set": [
      "sgn",
      "((nx*(0-gx)+ny*(0-gy))>0)*2-1"
     ]
    },
    {
     "set": [
      "qx",
      "(a_x+b_x)/2-sgn*nx*charge*0.3"
     ]
    },
    {
     "set": [
      "qy",
      "(a_y+b_y)/2-sgn*ny*charge*0.3"
     ]
    },
    {
     "set": [
      "lvx",
      "sgn*nx*(1.2+charge*1.8)"
     ]
    },
    {
     "set": [
      "lvy",
      "sgn*ny*(1.2+charge*1.8)"
     ]
    }
   ]
  },
  {
   "id": "charge",
   "when": {
    "every": 0.016
   },
   "do": [
    {
     "add": [
      "charge",
      0.0133
     ]
    },
    {
     "set": [
      "charge",
      "charge*(charge<1)+(charge>=1)"
     ]
    }
   ],
   "if": "state == 1"
  },
  {
   "id": "fly",
   "when": {
    "every": 0.016
   },
   "do": [
    {
     "add": [
      "vx",
      "gx*500*(1/60)"
     ]
    },
    {
     "add": [
      "vy",
      "gy*500*(1/60)"
     ]
    },
    {
     "velocity": {
      "target": "id:p",
      "v": [
       "vx",
       "vy"
      ]
     }
    }
   ],
   "if": "state == 2"
  },
  {
   "id": "held",
   "when": {
    "every": 0.016
   },
   "do": [
    {
     "teleport": {
      "target": "id:p",
