      "to": [
       20,
       170
      ]
     }
    }
   ]
  },
  {
   "id": "restore_crate",
   "when": {
    "touch": [
     "player",
     "crate_off"
    ]
   },
   "do": [
    {
     "become": {
      "target": "other",
      "prefab": "crate_on"
     }
    },
    {
     "play": "restore"
    }
   ]
  },
  {
   "id": "g3_step",
   "when": {
    "event": "beat"
   },
   "do": [
    {
     "set": [
      "g3x",
      "g3x + max(-10, min(10, 160 - g3x))"
     ]
    },
    {
     "set": [
      "g3y",
      "g3y + max(-10, min(10, 95 - g3y))"
     ]
    },
    {
     "teleport": {
      "target": "id:g3",
      "to": [
       "g3x",
       "g3y"
      ]
     }
    }
   ]
  },
  {
   "id": "g3_claims",
   "when": {
    "touch": [
     "g3",
     "bell_on"
    ]
   },
   "do": [
    {
     "become": {
      "target": "other",
      "prefab": "bell_off"
     }
    },
    {
     "play": "claim"
    },
    {
     "set": [
      "g3x",
      160
     ]
    },
    {
     "set": [
      "g3y",
      175
     ]
    },
    {
     "teleport": {
      "target": "id:g3",
      "to": [
       160,
       175
      ]
     }
    }
   ]
  },
  {
   "id": "restore_bell",
   "when": {
    "touch": [
     "player",
     "bell_off"
    ]
   },
   "do": [
    {
     "become": {
      "target": "other",
      "prefab": "bell_on"
     }
    },
    {
     "play": "restore"
    }
   ]
  },
  {
   "id": "wind",
   "when": {
    "event": "beat"
   },
   "if": "beat % 4 == 0",
   "do": [
    {
     "teleport": {
      "target": "id:p",
      "to": [
       "min(300, p_x + 14)",
       "p_y"
      ]
     }
    },
    {
     "play": "wind"
    }
   ]
  },
  {
   "id": "tide",
   "when": {
    "event": "beat"
   },
   "if": "beat % 6 == 0",
   "do": [
    {
     "become": {
      "target": "tag:bell_on",
      "prefab": "bell_off"
     }
    },
    {
     "play": "claim"
    }
   ]
  },
  {
   "id": "hurry",
   "when": {
    "event": "beat"
   },
   "if": "beat % 7 == 0",
   "do": [
    {
     "set": [
      "g1x",
      "g1x + max(-10, min(10, 50 - g1x))"
     ]
    },
    {
     "set": [
      "g1y",
      "g1y + max(-10, min(10, 40 - g1y))"
     ]
    },
    {
     "teleport": {
      "target": "id:g1",
      "to": [
       "g1x",
       "g1y"
      ]
     }
    },
    {
     "play": "wind"
    }
   ]
  },
  {
   "id": "lose_all",
   "when": {
    "every": 0.1
   },
   "if": "count_off >= 3 && ended == 0",
   "do": [
    {
     "end": "lose"
    }
   ]
  },
  {
   "id": "lose_late",
   "when": {
    "every": 0.1
   },
   "if": "beat >= 30 && ended == 0",
   "do": [
    {
     "end": "lose"
    }
   ]
  },
  {
   "id": "win",
   "when": {
    "touching": [
     "player",
     "door"
    ]
   },
   "if": "beat >= 8 && count_off == 0 && ended == 0",
   "do": [
    {
     "end": "win"
    }
   ]
  },
  {
   "id": "keep_best",
   "when": {
    "end": "win"
   },
   "do": [
    {
     "set": [
      "best",
      "(best == 0) * beat + (best != 0) * min(best, beat)"
     ]
    }
   ]
  }
 ],
