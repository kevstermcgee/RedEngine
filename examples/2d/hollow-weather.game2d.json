 "rules": [
  {
   "id": "turn_left",
   "when": {
    "press": "left"
   },
   "if": "last != 1 && ended == 0",
   "do": [
    {
     "set": [
      "last",
      1
     ]
    },
    {
     "emit": "beat"
    }
   ]
  },
  {
   "id": "turn_right",
   "when": {
    "press": "right"
   },
   "if": "last != 2 && ended == 0",
   "do": [
    {
     "set": [
      "last",
      2
     ]
    },
    {
     "emit": "beat"
    }
   ]
  },
  {
   "id": "turn_up",
   "when": {
    "press": "up"
   },
   "if": "last != 3 && ended == 0",
   "do": [
    {
     "set": [
      "last",
      3
     ]
    },
    {
     "emit": "beat"
    }
   ]
  },
  {
   "id": "turn_down",
   "when": {
    "press": "down"
   },
   "if": "last != 4 && ended == 0",
   "do": [
    {
     "set": [
      "last",
      4
     ]
    },
    {
     "emit": "beat"
    }
   ]
  },
  {
   "id": "tick",
   "when": {
    "event": "beat"
   },
   "do": [
    {
     "add": [
      "beat",
      1
     ]
    },
    {
     "set": [
      "wind_in",
      "4 - beat % 4"
     ]
    },
    {
     "set": [
      "tide_in",
      "6 - beat % 6"
     ]
    },
    {
     "set": [
      "hurry_in",
      "7 - beat % 7"
     ]
    },
    {
     "play": "tick"
    }
   ]
  },
  {
   "id": "g1_step",
   "when": {
    "event": "beat"
   },
   "do": [
    {
     "set": [
      "g1x",
      "g1x + max(-10, min(10, 50 - g1x))"
     ]
    },
    {
     "set": [
      "g1y",
      "g1y + max(-10, min(10, 40 - g1y))"
     ]
    },
    {
     "teleport": {
      "target": "id:g1",
      "to": [
       "g1x",
       "g1y"
      ]
     }
    }
   ]
  },
  {
   "id": "g1_claims",
   "when": {
    "touch": [
     "g1",
     "lamp_on"
    ]
   },
   "do": [
    {
     "become": {
      "target": "other",
      "prefab": "lamp_off"
     }
    },
    {
     "play": "claim"
    },
    {
     "set": [
      "g1x",
      300
     ]
    },
    {
     "set": [
      "g1y",
      170
     ]
    },
    {
     "teleport": {
      "target": "id:g1",
      "to": [
       300,
       170
      ]
     }
    }
   ]
  },
  {
   "id": "restore_lamp",
   "when": {
    "touch": [
     "player",
     "lamp_off"
    ]
   },
   "do": [
    {
     "become": {
      "target": "other",
      "prefab": "lamp_on"
     }
    },
    {
     "play": "restore"
    }
   ]
  },
  {
   "id": "g2_step",
   "when": {
    "event": "beat"
   },
   "do": [
    {
     "set": [
      "g2x",
      "g2x + max(-10, min(10, 270 - g2x))"
     ]
    },
    {
     "set": [
      "g2y",
      "g2y + max(-10, min(10, 50 - g2y))"
     ]
    },
    {
     "teleport": {
      "target": "id:g2",
      "to": [
       "g2x",
       "g2y"
      ]
     }
    }
   ]
  },
  {
   "id": "g2_claims",
