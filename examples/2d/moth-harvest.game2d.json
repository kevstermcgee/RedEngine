 "rules": [
  {
   "id": "weigh",
   "when": {
    "every": 0.05
   },
   "do": [
    {
     "set": [
      "lt",
      "1*count_wL1 + 2*count_wL2 + 3*count_wL3 + 5*count_wL5 + 7*count_wL7 + 9*count_wL9 + (p_x < 160) * (6 + count_moth)"
     ]
    },
    {
     "set": [
      "rt",
      "1*count_wR1 + 2*count_wR2 + 3*count_wR3 + 5*count_wR5 + 7*count_wR7 + 9*count_wR9 + (p_x >= 160) * (6 + count_moth)"
     ]
    },
    {
     "set": [
      "tilt",
      "max(-20, min(20, lt - rt))"
     ]
    },
    {
     "teleport": {
      "target": "id:needle",
      "to": [
       "160 + tilt * 5",
       28
      ]
     }
    },
    {
     "set": [
      "left",
      "max(0, 120 - time)"
     ]
    }
   ]
  },
  {
   "id": "danger_up",
   "when": {
    "every": 0.05
   },
   "if": "abs(tilt) >= 11",
   "do": [
    {
     "add": [
      "danger",
      0.05
     ]
    }
   ]
  },
  {
   "id": "danger_down",
   "when": {
    "every": 0.05
   },
   "if": "abs(tilt) < 11 && danger > 0",
   "do": [
    {
     "set": [
      "danger",
      "max(0, danger - 0.1)"
     ]
    }
   ]
  },
  {
   "id": "warn",
   "when": {
    "every": 0.5
   },
   "if": "danger > 0.1",
   "do": [
    {
     "play": "warn"
    }
   ]
  },
  {
   "id": "tip",
   "when": {
    "every": 0.05
   },
   "if": "danger >= 3",
   "do": [
    {
     "set": [
      "danger",
      3
     ]
    },
    {
     "end": "lose"
    }
   ]
  },
  {
   "id": "bell",
   "when": {
    "every": 0.05
   },
   "if": "time >= 120",
   "do": [
    {
     "end": "win"
    }
