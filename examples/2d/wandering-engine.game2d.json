 "rules": [
  {
   "id": "cycle",
   "when": {
    "press": "secondary"
   },
   "do": [
    {
     "set": [
      "col",
      "(col+1)%3"
     ]
    },
    {
     "play": "swap"
    }
   ]
  },
  {
   "id": "pourpblue",
   "when": {
    "press": "action"
   },
   "do": [
    {
     "spawn": {
      "prefab": "pblue",
      "at": "self"
     }
    },
    {
     "add": [
      "paint",
      -1
     ]
    },
    {
     "play": "pour"
    }
   ],
   "if": "col == 0 && paint > 0 && ended == 0",
   "cooldown": 0.35
  },
  {
   "id": "pourpyellow",
   "when": {
    "press": "action"
   },
   "do": [
    {
     "spawn": {
      "prefab": "pyellow",
      "at": "self"
     }
    },
    {
     "add": [
      "paint",
      -1
     ]
    },
    {
     "play": "pour"
    }
   ],
   "if": "col == 1 && paint > 0 && ended == 0",
   "cooldown": 0.35
  },
  {
   "id": "pourpred",
   "when": {
    "press": "action"
   },
   "do": [
    {
     "spawn": {
      "prefab": "pred",
      "at": "self"
     }
    },
    {
     "add": [
      "paint",
      -1
     ]
    },
    {
     "play": "pour"
    }
   ],
   "if": "col == 2 && paint > 0 && ended == 0",
   "cooldown": 0.35
  },
  {
   "id": "refill",
   "when": {
    "every": 3
   },
   "do": [
    {
     "add": [
      "paint",
      1
     ]
    }
   ],
   "if": "paint < 4"
  },
  {
   "id": "sweep",
   "when": {
    "every": 0.05
   },
   "do": [
    {
     "add": [
      "lx",
      "ldir * 0.05 * (30 + 30 * (lx >= 320))"
     ]
    },
    {
     "set": [
      "ldir",
      "ldir * (1 - 2 * (lx <= 0 || lx >= 640))"
     ]
    },
    {
     "teleport": {
      "target": "id:beam",
      "to": [
       "lx",
       90
      ]
     }
    }
   ]
  },
  {
   "id": "gate_open",
   "when": {
    "every": 0.05
   },
   "do": [
    {
     "become": {
      "target": "id:gate",
      "prefab": "gateopen"
     }
    },
    {
     "set": [
      "gopen",
      1
     ]
    }
   ],
   "if": "lx < 100 && gopen == 0"
  },
  {
   "id": "gate_shut",
   "when": {
    "every": 0.05
   },
   "do": [
    {
     "become": {
      "target": "id:gate",
      "prefab": "gate"
     }
    },
    {
     "set": [
      "gopen",
      0
     ]
    }
   ],
   "if": "lx >= 100 && gopen == 1"
  },
  {
   "id": "soak_y",
   "when": {
    "touching": [
     "player",
     "pyellow"
    ]
   },
   "do": [
    {
     "set": [
      "sy",
      1
     ]
    }
   ]
  },
  {
   "id": "soak_r",
   "when": {
    "touching": [
     "player",
     "pred"
    ]
   },
   "do": [
    {
     "set": [
      "sr",
      1
     ]
    }
   ]
  },
  {
   "id": "soak_w",
   "when": {
    "touching": [
     "player",
     "wind"
    ]
   },
   "do": [
    {
     "set": [
      "swind",
      1
     ]
    }
   ]
  },
  {
   "id": "code",
   "when": {
    "every": 0.03
   },
   "do": [
    {
     "set": [
      "code",
      "(sy * 3 + (1 - sy) * (2 - swind)) * 10 + (p_x < 320)"
     ]
    }
   ]
  },
  {
