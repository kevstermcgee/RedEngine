     }
    ]
   },
   {
    "name": "the key opens the gate and the generated meadow is still there",
    "seed": 1,
    "max_seconds": 15,
    "script": [
     {
      "approach": "key",
      "seconds": 6
     }
    ],
    "expect": [
     {
      "var": "gate_open",
      "eq": 1
     },
     {
      "count": "gate",
      "eq": 0
     },
     {
      "count": "key",
      "eq": 0
     },
     {
      "count": "tree",
      "eq": 19
     },
     {
      "event": "gate_opened",
      "min": 1
     },
     {
      "sound": "unlock"
     },
     {
      "reach": "tag:lantern",
      "from": "p"
     },
     {
      "not_ended": true
     }
    ]
   },
   {
    "name": "through the open gate to the lantern",
    "seed": 1,
    "max_seconds": 30,
    "smoke": true,
    "script": [
     {
      "approach": "key",
      "seconds": 6
     },
     {
      "approach": "lantern",
      "seconds": 12
     }
    ],
    "expect": [
     {
      "ended": "win"
     },
     {
      "var": "wins",
      "eq": 1
     },
     {
      "var": "gate_open",
      "eq": 0
     },
     {
      "count": "tree",
      "eq": 19
     },
     {
      "sound": "win"
     },
     {
      "sound": "pick"
     }
    ]
   },
   {
    "name": "play again closes the gate and keeps the count",
    "seed": 1,
    "max_seconds": 30,
    "script": [
     {
      "approach": "key",
      "seconds": 6
     },
     {
      "approach": "lantern",
      "seconds": 12
     },
     {
      "button": "restart"
     },
     {
      "wait": 0.2
     }
    ],
    "expect": [
     {
      "count": "gate",
      "eq": 1
     },
     {
      "count": "key",
      "eq": 1
     },
     {
      "var": "wins",
      "eq": 1
     },
     {
      "not_ended": true
     },
     {
      "reach": "tag:lantern",
      "from": "p",
