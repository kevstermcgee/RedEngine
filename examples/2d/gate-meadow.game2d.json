 "rules": [
  {
   "id": "take the key",
   "when": {
    "touch": [
     "player",
     "key"
    ]
   },
   "do": [
    {
     "set": [
      "gate_open",
      1
     ]
    },
    {
     "play": "pick"
    },
    {
     "destroy": "other"
    },
    {
     "destroy": "id:gate"
    },
    {
     "play": "unlock"
    },
    {
     "burst": {
      "at": [
       280,
       96
      ],
      "n": 14,
      "color": "#c9892f",
      "speed": [
       30,
       80
      ],
      "life": [
       0.3,
       0.7
      ]
     }
    },
    {
     "emit": "gate_opened"
    }
   ]
  },
  {
   "id": "the gate stays open after a restart",
   "when": {
    "start": true
   },
   "if": "gate_open == 1",
   "do": [
    {
     "destroy": "id:gate"
    },
    {
     "destroy": "tag:key"
    }
   ]
  },
  {
   "id": "the gate is open again after the save is loaded",
   "when": {
    "event": "loaded"
   },
   "if": "gate_open == 1",
   "do": [
    {
     "destroy": "id:gate"
    },
    {
     "destroy": "tag:key"
    }
   ]
  },
  {
   "id": "reach the lantern",
   "when": {
    "touch": [
     "player",
     "lantern"
    ]
   },
   "do": [
    {
     "add": [
      "wins",
      1
     ]
    },
    {
     "set": [
      "gate_open",
      0
     ]
    },
    {
     "end": "win"
    }
   ]
  },
  {
   "id": "win jingle",
   "when": {
    "end": "win"
   },
   "do": [
    {
     "play": "win"
    }
   ]
  },
  {
   "id": "again",
   "when": {
    "press": "action"
   },
   "if": "ended",
   "do": [
    {
     "restart": true
    }
   ]
  }
 ],
 "checks": {
  "reach": [
   {
    "from": "p",
    "to": "tag:key",
    "why": "the key is in the west meadow, reachable at the start"
   },
   {
    "from": "p",
    "to": "tag:lantern",
    "reachable": false,
    "why": "the gate keeps the lantern out of reach"
   },
   {
    "from": "p",
    "to": "tag:lantern",
    "open": [
     "gate"
    ],
    "why": "with the gate open the lantern can be reached"
   }
  ],
