   ],
   "color": "#ffe060",
   "align": "center",
   "show": "ended"
  }
 ],
 "rules": [
  {
   "id": "tick_idle",
   "when": {
    "every": 0.25
   },
   "do": [
    {
     "add": [
      "idle",
      0.25
     ]
    }
   ]
  },
  {
   "id": "earn",
   "when": {
    "every": 1
   },
   "if": "idle >= 1",
   "do": [
    {
     "add": [
      "coins",
      1
     ]
    },
    {
     "play": "coin"
    }
   ]
  },
  {
   "id": "multiply",
   "when": {
    "every": 2
   },
   "if": "idle >= 2 && coins >= 2",
   "do": [
    {
     "add": [
      "coins",
      "coins * 0.5"
     ]
    },
    {
     "play": "coin"
    }
   ]
  },
  {
   "id": "beat_rushed",
   "when": {
    "press": "action"
   },
   "if": "coins >= 2 && idle < 0.5",
   "do": [
    {
     "add": [
      "coins",
      -2
     ]
    },
    {
     "spawn": {
      "prefab": "link",
      "at": [
       "chain_x",
       105
      ]
     }
    },
    {
     "add": [
      "chain_x",
      9
     ]
    },
    {
     "add": [
      "links",
      1
     ]
    },
    {
     "set": [
      "idle",
      0
     ]
    },
    {
     "play": "beat"
    }
   ]
  },
  {
   "id": "beat_calm",
   "when": {
    "press": "action"
   },
   "if": "coins >= 1 && idle >= 0.5",
   "do": [
    {
     "add": [
      "coins",
      -1
     ]
    },
    {
     "spawn": {
      "prefab": "link",
      "at": [
       "chain_x",
       105
      ]
     }
    },
    {
     "add": [
      "chain_x",
      9
     ]
    },
    {
     "add": [
      "links",
      1
     ]
    },
    {
     "set": [
      "idle",
      0
     ]
    },
    {
     "play": "beat"
    }
   ]
  },
  {
   "id": "swarm",
   "when": {
    "every": 1
   },
   "if": "coins >= 6",
   "do": [
    {
     "spawn": {
      "prefab": "pest",
      "at": {
       "x": [
        70,
        140
       ],
       "y": [
        85,
        100
       ]
      }
     }
    },
    {
     "play": "denied"
    }
   ]
  },
  {
   "id": "bitten",
   "when": {
    "touch": [
     "cat",
     "pest"
    ]
   },
   "do": [
    {
     "add": [
      "lives",
      -1
     ]
    },
    {
     "destroy": "other"
    },
    {
     "shake": 2
    },
    {
     "play": "ouch"
    }
   ]
  },
  {
   "id": "dead",
   "when": {
    "every": 0.1
   },
   "if": "lives <= 0",
   "do": [
    {
     "end": "lose"
    }
   ]
  },
  {
   "id": "won",
   "when": {
    "every": 0.1
   },
   "if": "chain_x >= 280",
   "do": [
    {
     "end": "win"
    }
   ]
  },
  {
   "id": "record",
   "when": {
    "end": "win"
   },
   "if": "best == 0 || time < best",
   "do": [
    {
     "set": [
      "best",
      "time"
     ]
    },
    {
     "play": "fanfare"
    }
   ]
  }
 ],
