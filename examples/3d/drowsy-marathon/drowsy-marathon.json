 "rules": [
  {
   "id": "setup",
   "when": {
    "start": true
   },
   "do": [
    {
     "deactivate": "hedge_low"
    },
    {
     "hide": "rival_2"
    },
    {
     "hide": "rival_3"
    },
    {
     "hide": "kite_2"
    },
    {
     "hide": "kite_3"
    },
    {
     "hide": "kite_flag"
    }
   ]
  },
  {
   "id": "shrink",
   "when": {
    "enter": {
     "zone": "shrink"
    }
   },
   "do": [
    {
     "set": [
      "big",
      false
     ]
    },
    {
     "deactivate": "hedge_tall"
    },
    {
     "activate": "hedge_low"
    },
    {
     "emit": "shrunk"
    }
   ]
  },
  {
   "id": "grow",
   "when": {
    "enter": {
     "zone": "grow"
    }
   },
   "do": [
    {
     "set": [
      "big",
      true
     ]
    },
    {
     "deactivate": "hedge_low"
    },
    {
     "activate": "hedge_tall"
    },
    {
     "emit": "enlarged"
    }
   ]
  },
  {
   "id": "noise",
   "when": {
    "event": "swing"
   },
   "do": [
    {
     "set": [
      "noise",
      5
     ]
    },
    {
     "deactivate": "hush_1"
    },
    {
     "deactivate": "hush_2"
    },
    {
     "emit": "noisy"
    }
   ]
  },
  {
   "id": "hush_tick",
   "when": {
    "every": 1
   },
   "do": [
    {
     "add": [
      "noise",
      -1
     ]
    }
   ],
   "if": "noise > 0"
  },
  {
   "id": "hush_solid",
   "when": {
    "every": 1
   },
   "do": [
    {
     "activate": "hush_1"
    },
    {
     "activate": "hush_2"
    }
   ],
   "if": "noise <= 0"
  },
  {
   "id": "bed_in",
   "when": {
    "enter": {
     "zone": "bed"
    }
   },
   "do": [
    {
     "set": [
      "in_bed",
      true
     ]
    }
   ]
  },
  {
   "id": "bed_out",
   "when": {
    "exit": {
     "zone": "bed"
    }
   },
   "do": [
    {
     "set": [
      "in_bed",
      false
     ]
    }
   ]
  },
  {
   "id": "tend",
   "when": {
    "every": 1
   },
   "do": [
    {
     "add": [
      "plant",
      1
     ]
    },
    {
     "emit": "tended"
    }
   ],
   "if": "in_bed && big"
  },
  {
   "id": "rival_grow",
   "when": {
    "every": 1
   },
   "do": [
    {
     "add": [
      "rival",
      1
     ]
    }
   ]
  },
  {
   "id": "kite_2",
   "when": {
    "every": 0.5
   },
   "do": [
    {
     "show": "kite_2"
    }
   ],
   "if": "plant >= 4"
  },
  {
   "id": "kite_3",
   "when": {
    "every": 0.5
   },
   "do": [
    {
     "show": "kite_3"
    }
   ],
   "if": "plant >= 8"
  },
  {
   "id": "rival_2",
   "when": {
    "every": 0.5
   },
   "do": [
    {
     "show": "rival_2"
    }
   ],
   "if": "rival >= 12"
  },
  {
   "id": "rival_3",
   "when": {
    "every": 0.5
   },
   "do": [
    {
     "show": "rival_3"
    }
   ],
   "if": "rival >= 22"
  },
  {
   "id": "win",
   "when": {
    "every": 0.5
   },
   "do": [
    {
     "show": "kite_flag"
    },
    {
     "emit": "victory"
    },
    {
     "end": "victory"
    }
   ],
   "if": "plant >= 10"
  },
  {
   "id": "lose",
   "when": {
    "every": 0.5
   },
   "do": [
    {
     "emit": "defeat"
    },
    {
     "end": "lose"
    }
   ],
   "if": "rival >= 30"
  }
 ],
