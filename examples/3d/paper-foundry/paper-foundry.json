 "rules": [
  {
   "id": "setup",
   "when": {
    "start": true
   },
   "do": [
    {
     "hide": "shade_1"
    },
    {
     "hide": "shade_2"
    },
    {
     "hide": "shade_3"
    }
   ]
  },
  {
   "id": "take_ember",
   "when": {
    "event": "pickup",
    "prop": [
     "jar_a_e",
     "jar_c_e"
    ]
   },
   "do": [
    {
     "set": [
      "hue",
      1
     ]
    },
    {
     "emit": "dyed"
    }
   ]
  },
  {
   "id": "take_moss",
   "when": {
    "event": "pickup",
    "prop": [
     "jar_b_m",
     "jar_c_m"
    ]
   },
   "do": [
    {
     "set": [
      "hue",
      2
     ]
    },
    {
     "emit": "dyed"
    }
   ]
  },
  {
   "id": "take_sky",
   "when": {
    "event": "pickup",
    "prop": [
     "jar_b_s",
     "jar_c_s"
    ]
   },
   "do": [
    {
     "set": [
      "hue",
      3
     ]
    },
    {
     "emit": "dyed"
    }
   ]
  },
  {
   "id": "drop_jar",
   "when": {
    "event": "drop",
    "prop": [
     "jar_a_e",
     "jar_b_m",
     "jar_b_s",
     "jar_c_e",
     "jar_c_m",
     "jar_c_s"
    ]
   },
   "do": [
    {
     "set": [
      "hue",
      0
     ]
    }
   ]
  },
  {
   "id": "take_creature",
   "when": {
    "event": "pickup",
    "prop": "creature"
   },
   "do": [
    {
     "set": [
      "hue",
      4
     ]
    },
    {
     "set": [
      "hot",
      1
     ]
    },
    {
     "emit": "lifted"
    }
   ]
  },
  {
   "id": "drop_creature",
   "when": {
    "event": "drop",
    "prop": "creature"
   },
   "do": [
    {
     "set": [
      "hue",
      0
     ]
    },
    {
     "set": [
      "hot",
      0
     ]
    }
   ]
  },
  {
   "id": "open_1",
   "when": {
    "enter": {
     "zone": "gate_1_pad"
    }
   },
   "if": "hue == 1 && want == 1",
   "do": [
    {
     "deactivate": "gate_1"
    },
    {
     "hide": "gate_1_sign"
    },
    {
     "add": [
      "gates",
      1
     ]
    },
    {
     "set": [
      "want",
      2
     ]
    },
    {
     "set": [
      "hue",
      0
     ]
    },
    {
     "reset": [
      "jar_a_e",
      "jar_b_m",
      "jar_b_s",
      "jar_c_e",
      "jar_c_m",
      "jar_c_s"
     ]
    },
    {
     "emit": "open"
    }
   ]
  },
  {
   "id": "refuse_1",
   "when": {
    "enter": {
     "zone": "gate_1_pad"
    }
   },
   "if": "hue > 0 && hue < 4 && hue != 1 && want == 1 && grace == 0",
   "do": [
    {
     "set": [
      "dread",
      "dread * 2 + 1"
     ]
    },
    {
     "set": [
      "burn_t",
      1
     ]
    },
    {
     "timer": [
      "burn_clear",
      3
     ]
    },
    {
     "set": [
      "grace",
      1
     ]
    },
    {
     "timer": [
      "grace_clear",
      1.5
     ]
    },
    {
     "emit": "burn"
    },
    {
     "teleport": [
      0,
      0,
      -4.5
     ]
    }
   ]
  },
  {
   "id": "open_2",
   "when": {
    "enter": {
     "zone": "gate_2_pad"
    }
   },
   "if": "hue == 2 && want == 2",
   "do": [
    {
     "deactivate": "gate_2"
    },
    {
     "hide": "gate_2_sign"
    },
    {
     "add": [
      "gates",
      1
     ]
    },
    {
     "set": [
      "want",
      3
     ]
    },
    {
     "set": [
      "hue",
      0
     ]
    },
    {
     "reset": [
      "jar_a_e",
      "jar_b_m",
      "jar_b_s",
      "jar_c_e",
      "jar_c_m",
      "jar_c_s"
     ]
    },
    {
     "emit": "open"
    }
   ]
  },
  {
   "id": "refuse_2",
   "when": {
    "enter": {
     "zone": "gate_2_pad"
    }
   },
   "if": "hue > 0 && hue < 4 && hue != 2 && want == 2 && grace == 0",
   "do": [
    {
     "set": [
