  ],
  "objective": [
   {
    "if": "hot == 1",
    "text": "Carry it into the HOME ring and set it down (E)! The Shade creeps closer every 3 seconds"
   },
   {
    "if": "burn_t > 0",
    "text": "Wrong colour! The Shade doubles its steps. Match your glow"
   },
   {
    "if": "want == 4",
    "text": "All gates open. Lift the lost creature (E) and carry it to the HOME ring"
   },
   {
    "if": "hue == 1 && want == 1",
    "text": "You glow RED. Walk it to the red gate."
   },
   {
    "if": "hue == 2 && want == 2",
    "text": "You glow GREEN. Walk it to the green gate. Floor tiles of another colour burn you."
   },
   {
    "if": "hue == 3 && want == 3",
    "text": "You glow BLUE. Walk it to the blue gate. Floor tiles of another colour burn you."
   },
   {
    "if": "hue > 0 && hue != want && want == 1",
    "text": "Wrong jar for this gate. Put it down (E), fetch the red one"
   },
   {
    "if": "hue > 0 && hue != want && want == 2",
    "text": "Wrong jar for this gate. Put it down (E), fetch the green one"
   },
   {
    "if": "hue > 0 && hue != want && want == 3",
    "text": "Wrong jar for this gate. Put it down (E), fetch the blue one"
   },
   {
    "if": "want == 1",
    "text": "Pick up the red jar (E) and carry it to the red gate"
   },
   {
    "if": "want == 2",
    "text": "Pick up the green jar (E) and carry it to the green gate"
   },
   {
    "if": "want == 3",
    "text": "Pick up the blue jar (E) and carry it to the blue gate"
   },
   {
    "text": "Find the lost creature"
   }
  ],
  "start": {
   "title": "Paper Foundry",
   "text": "Your lantern is the only light. You glow the colour of the jar you carry (E picks up, E puts down); a gate opens only for its own colour. Free the lost creature and bring it HOME. Wrong colours wake the Shade: each mistake doubles it.",
   "button": "Light the lantern"
  },
  "end": {
   "victory": {
    "title": "Home",
    "text": "The creature is back where it first appeared.",
    "button": "Again"
   },
   "lose": {
    "title": "The Shade caught you",
    "text": "Wrong colours doubled its steps, or the way home took too long.",
    "button": "Again"
   }
  }
 },
