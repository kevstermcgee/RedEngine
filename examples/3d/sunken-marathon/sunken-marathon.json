  {
   "id": "clock_cart",
   "when": {
    "every": 1
   },
   "do": [
    {
     "add": [
      "_cacc",
      "ct"
     ]
    },
    {
     "add": [
      "_wacc",
      "ws"
     ]
    }
   ]
  },
  {
   "id": "cart_step",
   "when": {
    "every": 1
   },
   "if": "_cacc >= 3",
   "do": [
    {
     "add": [
      "c",
      1
     ]
    },
    {
     "add": [
      "_cacc",
      -3
     ]
    },
    {
     "emit": "cartmoved"
    }
   ]
  },
  {
   "id": "wall_step",
   "when": {
    "every": 1
   },
   "if": "_wacc >= 4",
   "do": [
    {
     "add": [
      "wall",
      1
     ]
    },
    {
     "add": [
      "_wacc",
      -4
     ]
    },
    {
     "emit": "wallmoved"
    },
    {
     "emit": "tide"
    }
   ]
  },
  {
   "id": "cart_show_0",
   "when": {
    "event": "cartmoved"
   },
