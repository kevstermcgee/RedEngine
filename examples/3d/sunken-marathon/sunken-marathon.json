   {
    "var": "ash",
    "of": 5,
    "label": "Ash twin (teal)"
   },
   {
    "var": "ember",
    "of": 5,
    "label": "Ember twin (orange)"
   }
  ],
  "objective": [
   {
    "if": "wall >= 3 && ash < 5",
    "text": "The tide shut the teal lane: Ash can lay no more. Shove it back (costs a spare piece)!"
   },
   {
    "text": "Lay 5 teal + 5 orange track pieces, exactly even. Shelf plates trade cart speed for tide speed."
   }
  ],
  "start": {
   "title": "Sunken Marathon",
   "text": "Two twins, one pair of hands. Step on a plate to lay the next piece: teal for Ash, orange for Ember. Finish with exactly 5 each. A cart gains on you and a tide wall closes on the teal side; they share one speed budget (the shelf plates move it), and a shove costs a spare piece for good.",
   "button": "Start"
  },
  "end": {
   "victory": {
    "title": "Even.",
    "text": "Ash {ash}, Ember {ember}. Both twins finish together.",
    "button": "Again"
   },
   "lopsided": {
    "title": "Uneven",
    "text": "Ash {ash}, Ember {ember}. The twins cannot finish apart.",
    "button": "Again"
   },
   "crushed": {
    "title": "Run over",
    "text": "The cart caught the end of the track.",
    "button": "Again"
   },
   "drowned": {
    "title": "Drowned",
    "text": "The tide wall closed.",
    "button": "Again"
   }
  }
