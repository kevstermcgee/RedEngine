  "ui": {
    "title": "Velvet Orchestra",
    "labels": { "returned": "Returned", "heard": "Heard", "noise": "Noise", "freq": "Dial" },
    "counters": [{ "var": "returned", "of": 5, "label": "Returned" }, { "var": "heard", "of": 3, "label": "Heard" }, { "var": "noise", "label": "Noise" }],
    "objective": [
      {
        "if": "freq == 0",
        "text": "88.1 Static: the room leans gently. Pick up a glowing stone (E): everything falls toward it, wherever you carry or set it down. The teal radio can (E) turns the dial"
      },
      {
        "if": "freq == 1",
        "text": "94.5 Waltz: the pull is a rush. Set a stone down in a brass slot and the things of its colour fall out through it"
      },
      {
        "if": "freq == 2",
        "text": "101.2 Hush: no pull, no noise. Carry stones in silence, or bat things by hand while the Listener stands at a slot"
      },
      { "text": "107.7 Inverse: everything is pushed AWAY from the last stone you picked up" }
    ],
    "start": {
      "title": "Velvet Orchestra",
      "text": "Tonight you return everything you ever stole. Five things must leave through the brass slots, each by the slot of its colour. Gravity points at the last glowing stone you picked up, wherever you carry it or set it down. The teal radio can (E) changes the rule. Touching, swinging and dialling make noise, and noise draws the Listener to a slot. Three times heard ends the night.",
      "button": "Tune in"
    },
    "end": {
      "victory": { "title": "Nothing left but you", "text": "The hall is bare. The radio hums to itself.", "button": "Again" },
      "lose": { "title": "Heard", "text": "The Listener turned his ear to you three times.", "button": "Again" }
    }
  },
  "rules": [
    {
      "id": "setup",
      "when": { "start": true },
      "do": [{ "hide": "listener_1" }, { "hide": "listener_2" }, { "hide": "listener_3" }, { "hide": "fq_1" }, { "hide": "fq_2" }, { "hide": "fq_3" }]
    },
    {
      "id": "dial_turn",
      "when": { "event": "pickup", "prop": "knob" },
      "do": [{ "set": ["freq", "(freq + 1) % 4"] }, { "reset": "self" }, { "emit": "tuned" }]
    },
    { "id": "dial_noise", "when": { "event": "tuned" }, "if": "freq != 2", "do": [{ "add": ["noise", 4] }] },
    { "id": "lamp_on_0", "when": { "every": 0.25 }, "if": "freq == 0", "do": [{ "show": "fq_0" }] },
    { "id": "lamp_off_0", "when": { "every": 0.25 }, "if": "freq != 0", "do": [{ "hide": "fq_0" }] },
    { "id": "lamp_on_1", "when": { "every": 0.25 }, "if": "freq == 1", "do": [{ "show": "fq_1" }] },
    { "id": "lamp_off_1", "when": { "every": 0.25 }, "if": "freq != 1", "do": [{ "hide": "fq_1" }] },
    { "id": "lamp_on_2", "when": { "every": 0.25 }, "if": "freq == 2", "do": [{ "show": "fq_2" }] },
    { "id": "lamp_off_2", "when": { "every": 0.25 }, "if": "freq != 2", "do": [{ "hide": "fq_2" }] },
    { "id": "lamp_on_3", "when": { "every": 0.25 }, "if": "freq == 3", "do": [{ "show": "fq_3" }] },
    { "id": "lamp_off_3", "when": { "every": 0.25 }, "if": "freq != 3", "do": [{ "hide": "fq_3" }] },
    {
      "id": "touch",
      "when": { "event": "pickup", "prop": ["stone_w", "stone_e", "stone_n"] },
      "do": [{ "aim": ["gravity", "self"] }, { "emit": "touched" }]
    },
    { "id": "touch_noise", "when": { "event": "touched" }, "if": "freq != 2", "do": [{ "add": ["noise", 3] }] },
    { "id": "swing_noise", "when": { "event": "swing" }, "if": "freq != 2", "do": [{ "add": ["noise", 2] }] },
    { "id": "noise_decay", "when": { "every": 2 }, "if": "noise > 0", "do": [{ "add": ["noise", -1] }] },
    {
      "id": "arrive",
      "when": { "every": 0.25 },
      "if": "noise >= 6 && listen == 0",
      "do": [{ "set": ["listen", 1] }, { "set": ["at", "at % 3 + 1"] }, { "set": ["lt", 12] }, { "set": ["noise", 2] }, { "emit": "arrived" }]
    },
    { "id": "ear_show_1", "when": { "every": 0.25 }, "if": "listen == 1 && at == 1", "do": [{ "show": "listener_1" }] },
    { "id": "ear_hide_1", "when": { "every": 0.25 }, "if": "listen == 0 || at != 1", "do": [{ "hide": "listener_1" }] },
    { "id": "ear_show_2", "when": { "every": 0.25 }, "if": "listen == 1 && at == 2", "do": [{ "show": "listener_2" }] },
    { "id": "ear_hide_2", "when": { "every": 0.25 }, "if": "listen == 0 || at != 2", "do": [{ "hide": "listener_2" }] },
    { "id": "ear_show_3", "when": { "every": 0.25 }, "if": "listen == 1 && at == 3", "do": [{ "show": "listener_3" }] },
    { "id": "ear_hide_3", "when": { "every": 0.25 }, "if": "listen == 0 || at != 3", "do": [{ "hide": "listener_3" }] },
    {
      "id": "hear",
      "when": { "every": 0.5 },
      "if": "listen == 1 && noise >= 5",
      "do": [{ "add": ["heard", 1] }, { "set": ["noise", 2] }, { "emit": "heard" }]
    },
    { "id": "linger", "when": { "every": 1 }, "if": "listen == 1", "do": [{ "add": ["lt", -1] }] },
    {
      "id": "depart",
      "when": { "every": 0.25 },
      "if": "listen == 1 && lt <= 0",
      "do": [{ "set": ["listen", 0] }, { "set": ["noise", 0] }, { "emit": "departed" }]
    },
    {
      "id": "bounce_w",
      "when": { "prop_enter": { "zone": "ex_1" }, "prop": ["it_chair", "it_crate", "it_barrel", "it_plant", "it_table"] },
      "if": "listen == 1 && at == 1",
      "do": [{ "reset": "self" }, { "aim": ["gravity", null] }, { "add": ["noise", 1] }, { "emit": "bounced" }]
    },
    {
      "id": "return_w",
      "when": { "prop_enter": { "zone": "ex_1" }, "prop": ["it_chair", "it_table"] },
      "if": "!(listen == 1 && at == 1)",
      "do": [{ "add": ["returned", 1] }, { "hide": "self" }, { "place": ["self", [-6, 3, 8.2]] }, { "emit": "returned" }]
    },
    {
      "id": "bounce_e",
      "when": { "prop_enter": { "zone": "ex_2" }, "prop": ["it_chair", "it_crate", "it_barrel", "it_plant", "it_table"] },
      "if": "listen == 1 && at == 2",
      "do": [{ "reset": "self" }, { "aim": ["gravity", null] }, { "add": ["noise", 1] }, { "emit": "bounced" }]
    },
    {
      "id": "return_e",
      "when": { "prop_enter": { "zone": "ex_2" }, "prop": ["it_crate", "it_plant"] },
      "if": "!(listen == 1 && at == 2)",
      "do": [{ "add": ["returned", 1] }, { "hide": "self" }, { "place": ["self", [6, 3, 8.2]] }, { "emit": "returned" }]
    },
    {
      "id": "bounce_n",
      "when": { "prop_enter": { "zone": "ex_3" }, "prop": ["it_chair", "it_crate", "it_barrel", "it_plant", "it_table"] },
      "if": "listen == 1 && at == 3",
      "do": [{ "reset": "self" }, { "aim": ["gravity", null] }, { "add": ["noise", 1] }, { "emit": "bounced" }]
    },
    {
      "id": "return_n",
      "when": { "prop_enter": { "zone": "ex_3" }, "prop": ["it_barrel"] },
      "if": "!(listen == 1 && at == 3)",
      "do": [{ "add": ["returned", 1] }, { "hide": "self" }, { "place": ["self", [0, 3, 8.2]] }, { "emit": "returned" }]
    },
    { "id": "win", "when": { "every": 0.25 }, "if": "returned >= 5", "do": [{ "emit": "victory" }, { "end": "victory" }] },
    { "id": "lose", "when": { "every": 0.25 }, "if": "heard >= 3", "do": [{ "emit": "caught" }, { "end": "lose" }] }
  ],
  "audio": { "music": { "dawn": "audio/waltz.json", "day": "audio/waltz.json", "dusk": "audio/waltz.json", "night": "audio/waltz.json" }, "music_volume": 0.6 },
  "music": false,
