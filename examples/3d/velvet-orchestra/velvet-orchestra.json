{
  "recipe": {
    "title": "Velvet Orchestra",
    "summary": "A thief returns five stolen things through brass slots; gravity points at the last glowing stone they picked up, wherever it is carried or set down, a radio dial rewrites the pull, and every sound draws a Listener to a new slot.",
    "teaches": [
      "an aimed field: `fields[].toward` + `speed` (an expression over the dial), re-aimed by a rule with `aim [field, self]`",
      "the rule's subject `self` and the `prop` filter: one rule per slot instead of one per thing",
      "dial = pickup filtered to the knob + reset self + modulo var; noise var + listener that blocks a slot"
    ]
  },
  "meta": { "fps": 30, "duration": 6, "resolution": [1280, 720] },
  "style": {
