   {
    "if": "walking > 0",
    "text": "The moth is moving: WALK and chalk the house on the board"
   },
   {
    "text": "The moth is still: FREEZE (do not step onto a new tile)"
   }
  ],
  "start": {
   "title": "Gentle Carousel",
   "text": "Walk onto a tile to chalk it and light its lamp. Chalked tiles crumble soon after. You may only step while the blue moth flutters; step while it rests and the shy dark startles (3 frights and it flees). Trace the house shown on the board without more than 2 smudges.",
   "button": "Light up"
  },
  "end": {
   "victory": {
    "title": "A house in lamplight",
    "text": "Strangers will know it.",
    "button": "Again"
   },
