  "show_combat": false,
  "show_scoreboard": false,
  "show_ping": false,
  "show_events": false,
  "show_help": false
 },
 "rules": [
  {
   "id": "init",
   "when": {
    "start": true
   },
   "do": [
    {
     "for_each": "tile",
     "do": [
      {
       "deactivate": "$tile"
      }
     ]
    },
    {
     "for_each": "cell",
     "do": [
      {
       "hide": "lamp_$cell"
      }
     ]
    },
    {
     "set": [
      "_s_t40",
      3
     ]
    },
    {
     "show": "lamp_t40"
    },
    {
     "add": [
      "good",
      1
     ]
    }
   ]
  },
  {
   "id": "init_rev_$first",
   "for_each": "first",
   "when": {
    "start": true
   },
   "do": [
    {
     "activate": "$first"
    },
    {
     "set": [
      "_s_$first",
      1
     ]
    }
   ]
  },
  {
   "id": "beat",
   "when": {
    "every": 1
   },
   "do": [
    {
     "add": [
      "t",
      1
     ]
    },
    {
     "set": [
      "t",
      "t % 6"
     ]
    },
    {
     "set": [
      "walking",
      "t < 4"
     ]
    }
   ]
  },
  {
   "id": "moth_$stop",
   "for_each": "stop",
   "when": {
    "every": 1
   },
   "if": "t == $stop",
   "do": [
    {
     "place": [
      "moth",
      "$stop.at"
     ]
    }
   ]
  },
  {
   "id": "tide",
   "when": {
    "every": 4
   },
   "do": [
    {
     "emit": "tide"
    }
   ]
  },
  {
   "id": "break_$tile",
   "for_each": "tile",
   "when": {
    "event": "tide"
   },
   "if": "_s_$tile == 3",
   "do": [
    {
     "set": [
      "_s_$tile",
      4
     ]
    },
    {
     "deactivate": "$tile"
    },
    {
     "emit": "crack"
    }
   ]
  },
  {
   "id": "age_$tile",
   "for_each": "tile",
   "when": {
    "event": "tide"
   },
   "if": "_s_$tile == 2",
   "do": [
    {
     "set": [
      "_s_$tile",
      3
     ]
    }
   ]
  },
  {
   "for_each": "tile",
   "rules": [
    {
     "id": "chalk_$tile",
     "when": {
      "enter": {
       "box": "$tile.box"
      }
     },
     "if": "walking > 0 && _s_$tile == 1",
     "do": [
      {
       "set": [
        "_s_$tile",
        2
       ]
      },
      {
       "show": "lamp_$tile"
      },
      {
       "add": [
        "$tile.count",
        1
       ]
      },
      {
       "emit": "chalk"
      }
     ]
    },
    {
     "id": "stumble_$tile",
     "when": {
      "enter": {
       "box": "$tile.box"
      }
     },
     "if": "walking < 1",
     "do": [
      {
       "emit": "misstep"
      }
     ]
    },
    {
     "id": "rev_$tile_$n",
     "for_each": "n",
     "in": "$tile.near",
     "when": {
      "enter": {
       "box": "$tile.box"
      }
     },
     "if": "walking > 0 && _s_$n == 0",
     "do": [
      {
       "activate": "$n"
      },
      {
       "set": [
        "_s_$n",
        1
       ]
      }
     ]
    }
   ]
  },
  {
   "id": "startle",
   "when": {
    "event": "misstep"
   },
   "cooldown": 1.5,
   "do": [
    {
     "add": [
      "scare",
      1
     ]
    },
    {
     "teleport": "start"
    },
    {
     "emit": "stumble"
    }
   ]
  },
  {
   "id": "fall",
   "when": {
    "enter": {
     "box": [
      -30,
      -1,
      -30,
      30,
      0.12,
      30
     ]
    }
   },
   "do": [
    {
     "emit": "fell"
    },
    {
     "end": "fell"
    }
   ]
  },
  {
   "id": "scared",
   "when": {
    "every": 0.2
   },
   "if": "scare >= 3",
   "do": [
    {
     "end": "spooked"
    }
   ]
  },
  {
   "id": "smudged",
   "when": {
    "every": 0.2
   },
   "if": "stray >= 3",
   "do": [
    {
     "end": "smudged"
    }
   ]
  },
  {
   "id": "win",
   "when": {
    "every": 0.2
   },
   "if": "good >= 12 && stray < 3",
   "do": [
    {
     "emit": "victory"
    },
    {
     "end": "victory"
    }
   ]
  }
 ],
 "checks": {
  "lint": {
   "max_errors": 0,
   "max_warnings": 0,
   "ignore": [
    "floating",
    "overlap"
   ]
  },
