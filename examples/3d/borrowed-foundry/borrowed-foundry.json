    }
   ],
   "if": "echo <= 0 || nap_3 <= 0"
  },
  {
   "id": "swap_1",
   "when": {
    "event": "pickup"
   },
   "do": [
    {
     "set": [
      "host",
      1
     ]
    },
    {
     "set": [
      "breath",
