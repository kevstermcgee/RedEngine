    }
   ],
   "if": "host > 0 && breath <= 0"
  },
  {
   "id": "count",
   "when": {
    "every": 0.25
   },
   "do": [
    {
     "set": [
      "asleep",
      "(nap_1 > 0) + (nap_2 > 0) + (nap_3 > 0)"
     ]
    }
   ]
  },
  {
   "id": "energy",
   "when": {
    "every": 0.5
   },
   "do": [
