   "victory": {
    "title": "Hush",
    "text": "All three asleep at the same moment.",
    "button": "Again"
   },
   "lose": {
    "title": "Out of breath",
    "text": "Your energy ran dry.",
    "button": "Again"
   }
  }
 },
 "rules": [
  {
   "id": "dark",
   "when": {
    "start": true
   },
   "do": [
    {
     "hide": "shell"
    },
    {
     "hide": "wasp_1"
    },
    {
     "hide": "nap_1"
    },
    {
     "hide": "wasp_2"
    },
    {
     "hide": "nap_2"
    },
    {
     "hide": "wasp_3"
    },
    {
     "hide": "nap_3"
    },
    {
     "emit": "dark"
    }
   ]
  },
  {
   "id": "echo",
   "when": {
    "event": "swing"
   },
   "do": [
    {
     "set": [
      "echo",
      4
     ]
    },
    {
     "show": "shell"
    },
    {
     "emit": "ping"
    }
   ]
  },
  {
   "id": "echo_fade",
   "when": {
    "every": 1
   },
   "do": [
    {
     "add": [
      "echo",
      -1
     ]
    }
   ],
   "if": "echo > 0"
  },
  {
   "id": "echo_off",
   "when": {
    "every": 0.25
   },
   "do": [
    {
     "hide": "shell"
    }
   ],
   "if": "echo <= 0"
  },
  {
   "id": "echo_on",
   "when": {
    "every": 0.25
   },
   "do": [
    {
     "show": "shell"
    }
   ],
   "if": "echo > 0"
  },
  {
   "id": "w1_awake_show",
   "when": {
    "every": 0.25
   },
   "do": [
    {
     "show": "wasp_1"
    }
   ],
   "if": "echo > 0 && nap_1 <= 0"
  },
  {
   "id": "w1_awake_hide",
   "when": {
    "every": 0.25
   },
   "do": [
    {
     "hide": "wasp_1"
    }
   ],
   "if": "echo <= 0 || nap_1 > 0"
  },
  {
   "id": "w1_nap_show",
   "when": {
    "every": 0.25
   },
   "do": [
    {
     "show": "nap_1"
    }
   ],
   "if": "echo > 0 && nap_1 > 0"
  },
  {
   "id": "w1_nap_hide",
   "when": {
    "every": 0.25
   },
   "do": [
    {
     "hide": "nap_1"
    }
   ],
   "if": "echo <= 0 || nap_1 <= 0"
  },
  {
   "id": "w2_awake_show",
   "when": {
    "every": 0.25
   },
   "do": [
    {
     "show": "wasp_2"
    }
   ],
   "if": "echo > 0 && nap_2 <= 0"
  },
  {
   "id": "w2_awake_hide",
   "when": {
    "every": 0.25
   },
   "do": [
    {
     "hide": "wasp_2"
    }
   ],
   "if": "echo <= 0 || nap_2 > 0"
  },
  {
   "id": "w2_nap_show",
   "when": {
    "every": 0.25
   },
   "do": [
    {
     "show": "nap_2"
    }
   ],
   "if": "echo > 0 && nap_2 > 0"
  },
  {
   "id": "w2_nap_hide",
