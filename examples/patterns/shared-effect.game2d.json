{
  "game2d": 1, "id": "pattern-shared-effect", "title": "Pattern: one effect, many sources",
  "description": "A heart and a key press both heal, through one named `effects` entry, so the sound, the event and the health cap live in one place. Mechanic: `effects` with `params`, `apply` with `with`, a rule on the effect's own event.",
  "capabilities": {"presentation": "2d", "platforms": ["web"], "networking": "offline", "input": ["keyboard", "touch"], "persistence": []},
  "view": {"width": 320, "height": 180, "background": "#161b2b"},
  "vars": {"lives": 1, "maxlives": 3},
  "sounds": {"heal": {"seconds": 0.3, "level": 0.5, "layers": [{"sine": 660, "decay": 9}]}},
  "effects": {
    "heal": {"about": "every healing goes through here", "params": ["amount"], "do": [{"add": ["lives", "$amount"]}, {"play": "heal"}, {"emit": "healed"}]}
  },
  "prefabs": {
    "player": {"tag": "player", "shape": {"rect": [8, 8], "color": "#ffd166"}, "layer": 2, "clamp": true, "body": {"type": "dynamic"}, "collide": [], "move": {"keys": {"mode": "topdown", "speed": 90}}},
    "heart": {"tag": "heart", "shape": {"circle": 5, "color": "#ff6b9a"}}
  },
  "scene": [
    {"prefab": "heart", "at": [200, 90]},
    {"prefab": "player", "at": [160, 90], "id": "p"}
  ],
  "ui": [{"text": "LIVES {lives}/{maxlives}  (X: heal 1)", "at": [6, 4], "color": "#ffffff"}],
  "rules": [
    {"id": "heart heals 2", "when": {"touch": ["player", "heart"]}, "do": [{"apply": "heal", "with": {"amount": 2}}, {"destroy": "other"}]},
    {"id": "key heals 1", "when": {"press": "secondary"}, "if": "lives < maxlives", "do": [{"apply": "heal", "with": {"amount": 1}}]},
    {"id": "health cap", "when": {"event": "healed"}, "if": "lives > maxlives", "do": [{"set": ["lives", "maxlives"]}]}
  ],
  "checks": {"scenarios": [
    {"name": "the heart heals through the effect", "seed": 1, "max_seconds": 6, "script": [{"approach": "heart", "seconds": 3}], "expect": [{"var": "lives", "eq": 3}, {"sound": "heal"}, {"event": "healed"}]},
    {"name": "the key heals through the same effect and the cap holds", "seed": 1, "max_seconds": 6, "script": [{"press": "secondary"}, {"wait": 0.1}, {"press": "secondary"}, {"wait": 0.1}, {"press": "secondary"}, {"wait": 0.1}], "expect": [{"var": "lives", "eq": 3}, {"sound": "heal", "min": 2}]}
  ]}
}
