      "color": "#fff1dc",
      "intensity": 2.5,
      "cast_shadows": true,
      "shadow_radius": 12,
      "shadow_center": [
        0,
        0,
        -1
      ]
    }
  ],
  "spawns": [
    {
      "id": "start",
      "position": [
        0,
        0,
        4
      ],
      "yaw_deg": 0
    }
  ],
  "vars": {
    "route": 0,
    "gears_shipped": 0,
    "widgets_sold": 0
  },
  "workshop": {
    "defs": [
      "defs/base.json",
      "defs/expansion.json"
    ],
    "seed": 7,
    "show": {
      "gears_shipped": "ws:ship",
      "widgets_sold": "wx:market"
    }
  },
  "rules": [
    {
      "id": "pull_lever",
      "when": {
        "enter": {
          "object": "lever",
          "pad": 0.2
        }
      },
      "do": [
        {
          "set": [
            "route",
            "1 - route"
          ]
        },
        {
          "emit": "lever"
        }
      ]
    },
    {
      "id": "order_done",
      "when": {
        "every": 0.25
      },
      "if": "gears_shipped >= 12",
      "once": true,
      "do": [
        {
          "end": "shipped"
        }
      ]
    }
  ],
  "ui": {
    "title": "Workshop",
    "labels": {
      "gears_shipped": "Gears shipped",
      "route": "Press output to dock",
      "widgets_sold": "Widgets sold"
    },
    "counters": [
      {
        "var": "gears_shipped",
        "of": 12,
        "label": "Order"
      },
      {
        "var": "widgets_sold",
        "label": "Widgets"
      }
    ],
    "objective": [
      {
        "if": "gears_shipped >= 12",
        "text": "The order is shipped"
      },
      {
        "if": "route == 1",
        "text": "Shipping: {gears_shipped} of 12 gears"
      },
      {
        "text": "Gears pile up: step on the lever to ship them"
      }
    ],
    "end": {
      "shipped": {
        "title": "Order shipped",
        "text": "12 gears left the dock.",
        "button": "Play again"
      }
    }
  },
