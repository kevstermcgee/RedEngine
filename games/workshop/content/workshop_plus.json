            "id": "p1",
            "character": "human",
            "spawn": "start"
          }
        ],
        "script": [
          {
            "player": "p1",
            "wait": 40
          }
        ],
        "max_seconds": 50,
        "inspect": [
          "wx:assembler_a",
          "wx:recycler_a"
        ],
        "expect": [
          {
            "game": "wx:assembler_a",
            "path": "state.made",
            "gte": 1
          },
          {
            "game": "wx:recycler_a",
            "path": "state.made",
            "gte": 1
          },
          {
            "var": "widgets_sold",
            "gte": 1
          },
          {
            "game": "wx:assembler_a",
            "path": "defined_at.file",
