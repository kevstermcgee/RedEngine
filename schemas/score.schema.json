{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Red Engine 2 music score",
  "description": "A score: `red_engine2 describe audio`. Generated by `red_engine2 schema` from src/content/; do not edit.",
  "type": "object",
  "properties": {
    "bpm": true,
    "beats": true,
    "bars": true,
    "key": {
      "type": [
        "string",
        "null"
      ]
    },
    "scale": {
      "type": [
        "string",
        "null"
      ]
    },
    "seed": true,
    "lufs": true,
    "reverb": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScoreReverb"
        },
        {
          "type": "null"
        }
      ]
    },
    "delay": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScoreDelay"
        },
        {
          "type": "null"
        }
      ]
    },
    "instruments": {
      "description": "name -> voice.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/Voice"
      }
    },
    "tracks": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ScoreTrack"
      }
    },
    "title": {
      "description": "The track's name for people (a pause menu shows it; an exported file is called it).",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ScoreReverb": {
      "description": "The score's reverb.",
      "type": "object",
      "properties": {
        "decay": true,
        "size": true,
        "damp": true,
        "predelay": true,
        "mix": true
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    },
    "ScoreDelay": {
      "description": "The score's delay.",
      "type": "object",
      "properties": {
        "time": true,
        "feedback": true,
        "damp": true,
        "mix": true
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    },
    "Voice": {
      "description": "One synthesized sound.",
      "type": "object",
      "properties": {
        "seconds": true,
        "level": true,
        "seed": true,
        "attack": true,
        "pitched": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "layers": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/VoiceLayer"
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    },
    "VoiceLayer": {
      "description": "One layer of a voice.",
      "type": "object",
      "properties": {
        "sine": true,
        "harmonics": true,
        "glide": true,
        "sweep": true,
        "noise": {
          "type": [
            "string",
            "null"
          ]
        },
        "decay": true,
        "fade_in": true,
        "delay": true,
        "attack": true,
        "release": true,
        "gain": true
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    },
    "ScoreTrack": {
      "description": "One track: an instrument and what it plays.",
      "type": "object",
      "properties": {
        "inst": {
          "type": [
            "string",
            "null"
          ]
        },
        "play": {
          "type": [
            "string",
            "null"
          ]
        },
        "chords": true,
        "every": true,
        "voicing": true,
        "strum": true,
        "pattern": true,
        "notes": true,
        "steps": true,
        "density": true,
        "range": true,
        "leap": true,
        "start": true,
        "octave": true,
        "hold": true,
        "gain": true,
        "pan": true,
        "send": true,
        "vel": true,
        "from": true,
        "to": true,
        "seed": true
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    }
  },
  "patternProperties": {
    "^(x-|x_|_)|^notes$|^\\$comment$": {}
  },
  "$id": "https://github.com/kevstermcgee/RedEngine/schemas/score.schema.json"
}
