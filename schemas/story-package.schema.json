{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Red Engine 2 compiled story",
  "description": "A `<story>.story.json` written by `story build`: `red_engine2 describe story`. Generated by `red_engine2 schema` from src/content/; do not edit.",
  "type": "object",
  "properties": {
    "story_package": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "story": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_version": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "source_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "sources": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "round": {
      "type": [
        "string",
        "null"
      ]
    },
    "holders": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "speakers": {
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "facts": {
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "infos": {
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "vars": {
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "exprs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "authored": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "lines": {
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "conversations": {
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "barks": {
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "categories": {
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "directors": {
      "type": [
        "array",
        "null"
      ],
      "items": true
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^(x-|x_|_)|^notes$|^\\$comment$": {}
  },
  "$id": "https://github.com/kevstermcgee/RedEngine/schemas/story-package.schema.json"
}
