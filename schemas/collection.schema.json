{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Red Engine 2 museum collection",
  "description": "A museum scene's `museum.collection` (`red_engine2 describe scene`, `red_engine2 museum`). Generated by `red_engine2 schema` from src/content/; do not edit.",
  "type": "object",
  "properties": {
    "styles": {
      "description": "Art style names, in the order the game's `museum.art` shader numbers them.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "materials": {
      "description": "Sculpture material names, in the shader's order.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "words": {
      "description": "Shared word lists: name -> words (a word may hold `{slots}`).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "artists": {
      "description": "Artist-name templates: the label, then after ` // ` how a story names them.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "media": {
      "anyOf": [
        {
          "$ref": "#/$defs/CollectionMedia"
        },
        {
          "type": "null"
        }
      ]
    },
    "stories": {
      "description": "Origin stories any theme's paintings may be given.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "object_stories": {
      "description": "Origin stories for sculptures, installations and tapestries.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "themes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/CollectionTheme"
      }
    },
    "masterpieces": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Masterpiece"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "CollectionMedia": {
      "description": "Media per kind of piece.",
      "type": "object",
      "properties": {
        "painting": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "tapestry": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "sculpture": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "installation": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    },
    "CollectionTheme": {
      "description": "A wing's mood.",
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "wing": {
          "type": [
            "string",
            "null"
          ]
        },
        "colors": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThemeColors"
            },
            {
              "type": "null"
            }
          ]
        },
        "palettes": {
          "description": "Four-colour palettes, darkest first.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "styles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "sculptures": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "music": {
          "description": "Indices into `audio.journey.scores`.",
          "type": [
            "array",
            "null"
          ],
          "items": true
        },
        "words": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "titles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "stories": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "hints": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    },
    "ThemeColors": {
      "description": "A theme's room colours.",
      "type": "object",
      "properties": {
        "wall": {
          "type": [
            "string",
            "null"
          ]
        },
        "floor": {
          "type": [
            "string",
            "null"
          ]
        },
        "trim": {
          "type": [
            "string",
            "null"
          ]
        },
        "ceiling": {
          "type": [
            "string",
            "null"
          ]
        },
        "light": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    },
    "Masterpiece": {
      "description": "A hand-written piece.",
      "type": "object",
      "properties": {
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "artist": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "string",
            "null"
          ]
        },
        "medium": {
          "type": [
            "string",
            "null"
          ]
        },
        "story": {
          "type": [
            "string",
            "null"
          ]
        },
        "theme": {
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    }
  },
  "patternProperties": {
    "^(x-|x_|_)|^notes$|^\\$comment$": {}
  },
  "$id": "https://github.com/kevstermcgee/RedEngine/schemas/collection.schema.json"
}
