{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Red Engine 2 playscript",
  "description": "A `*.play.json` for `playtest --script`: `red_engine2 describe playtest`. Generated by `red_engine2 schema` from src/content/; do not edit.",
  "type": "object",
  "properties": {
    "policy": {
      "type": [
        "string",
        "null"
      ]
    },
    "steps": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ScriptStep"
      }
    },
    "schema": true
  },
  "additionalProperties": false,
  "$defs": {
    "ScriptStep": {
      "description": "One step: one action, plus the modifiers it takes.",
      "type": "object",
      "properties": {
        "wait": true,
        "look": {
          "anyOf": [
            {
              "$ref": "#/$defs/Look"
            },
            {
              "type": "null"
            }
          ]
        },
        "turn": true,
        "hold": true,
        "jump": true,
        "fire": true,
        "aim_at": true,
        "switch": true,
        "interact": true,
        "press": true,
        "approach": true,
        "look_at": true,
        "view": true,
        "policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "shot": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot": true,
        "player": true,
        "expect": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScriptExpect"
            },
            {
              "type": "null"
            }
          ]
        },
        "wait_for": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScriptExpect"
            },
            {
              "type": "null"
            }
          ]
        },
        "say": {
          "type": [
            "string",
            "null"
          ]
        },
        "over": true,
        "secs": true,
        "camera": true,
        "track": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "every": true,
        "clicks": true,
        "msg": {
          "type": [
            "string",
            "null"
          ]
        },
        "within": true,
        "timeout": true
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    },
    "Look": {
      "description": "A direction to face.",
      "type": "object",
      "properties": {
        "yaw": true,
        "pitch": true
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    },
    "ScriptExpect": {
      "description": "An assertion on the state dump (a JSON pointer).",
      "type": "object",
      "properties": {
        "at": {
          "type": [
            "string",
            "null"
          ]
        },
        "eq": true,
        "ne": true,
        "min": true,
        "max": true,
        "contains": true,
        "exists": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "within": true,
        "msg": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    }
  },
  "patternProperties": {
    "^(x-|x_|_)|^notes$|^\\$comment$": {}
  },
  "$id": "https://github.com/kevstermcgee/RedEngine/schemas/playscript.schema.json"
}
