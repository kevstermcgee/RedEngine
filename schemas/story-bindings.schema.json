{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Red Engine 2 story bindings",
  "description": "What a game offers a story (`<game>_server story-bindings`): `describe story`. Generated by `red_engine2 schema` from src/content/; do not edit.",
  "type": "object",
  "properties": {
    "story_bindings": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "game": {
      "type": [
        "string",
        "null"
      ]
    },
    "about": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalog": true,
    "notes": true
  },
  "additionalProperties": false,
  "patternProperties": {
    "^(x-|x_|_)|^notes$|^\\$comment$": {}
  },
  "$id": "https://github.com/kevstermcgee/RedEngine/schemas/story-bindings.schema.json"
}
