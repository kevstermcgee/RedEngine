{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Red Engine 2 match trace",
  "description": "A `*.trace.json` written by `--record`. Generated by `red_engine2 schema` from src/content/; do not edit.",
  "type": "object",
  "properties": {
    "trace_version": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "engine": {
      "type": [
        "string",
        "null"
      ]
    },
    "tick_rate": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "scene": {
      "type": [
        "string",
        "null"
      ]
    },
    "map_hash": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "seed": {
      "type": [
        "string",
        "null"
      ]
    },
    "spawn_group": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "type": [
        "string",
        "null"
      ]
    },
    "checkpoint_every": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "dump_every": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "entries": {
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "checkpoints": {
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "events": {
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "dumps": {
      "type": [
        "array",
        "null"
      ],
      "items": true
    },
    "final_tick": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "patternProperties": {
    "^(x-|x_|_)|^notes$|^\\$comment$": {}
  },
  "$id": "https://github.com/kevstermcgee/RedEngine/schemas/trace.schema.json"
}
