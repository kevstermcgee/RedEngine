{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Red Engine 2 kart driver roster",
  "description": "`assets/data/drivers.json`. Generated by `red_engine2 schema` from src/content/; do not edit.",
  "type": "object",
  "properties": {
    "roster": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "about": {
      "type": [
        "string",
        "null"
      ]
    },
    "base": {
      "anyOf": [
        {
          "$ref": "#/$defs/KartSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "drivers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/Driver"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "KartSpec": {
      "description": "Kart numbers (each optional: laid over the base).",
      "type": "object",
      "properties": {
        "top_speed": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "accel": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "brake": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "reverse_speed": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "steer_rate": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "grip": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "mass": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "dirt": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "mud": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "water": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "boost_mult": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "drift_rate": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "hop_speed": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    },
    "Driver": {
      "description": "One driver: a name, an ability and the numbers it changes.",
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "ability": {
          "type": [
            "string",
            "null"
          ]
        },
        "spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/KartSpec"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    }
  },
  "patternProperties": {
    "^(x-|x_|_)|^notes$|^\\$comment$": {}
  },
  "$id": "https://github.com/kevstermcgee/RedEngine/schemas/drivers.schema.json"
}
