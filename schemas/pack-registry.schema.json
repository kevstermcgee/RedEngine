{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Red Engine 2 pack registry",
  "description": "`assets/packs.json`. Generated by `red_engine2 schema` from src/content/; do not edit.",
  "type": "object",
  "properties": {
    "format": {
      "description": "Format version (1).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "description": {
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/PackPolicy"
    },
    "packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Pack"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "description",
    "policy",
    "packs"
  ],
  "$defs": {
    "PackPolicy": {
      "description": "How the library grows.",
      "type": "object",
      "properties": {
        "foundation": {
          "type": "string"
        },
        "promotion": {
          "type": "string"
        },
        "compatibility": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "foundation",
        "promotion",
        "compatibility"
      ],
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    },
    "Pack": {
      "description": "One pack: an id, the file that holds it, what it is for.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "file": {
          "description": "The pack's file, repository-relative (`assets/food.json`; `crates/red_core/src/props.rs` for the engine-native props).",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "file",
        "description",
        "tags"
      ],
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    }
  },
  "patternProperties": {
    "^(x-|x_|_)|^notes$|^\\$comment$": {}
  },
  "$id": "https://github.com/kevstermcgee/RedEngine/schemas/pack-registry.schema.json"
}
