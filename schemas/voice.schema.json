{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Red Engine 2 voice",
  "description": "One sound (a 2D game's `sounds` entry, `audio export`). Generated by `red_engine2 schema` from src/content/; do not edit.",
  "type": "object",
  "properties": {
    "seconds": true,
    "level": true,
    "seed": true,
    "attack": true,
    "pitched": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "layers": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/VoiceLayer"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "VoiceLayer": {
      "description": "One layer of a voice.",
      "type": "object",
      "properties": {
        "sine": true,
        "harmonics": true,
        "glide": true,
        "sweep": true,
        "noise": {
          "type": [
            "string",
            "null"
          ]
        },
        "decay": true,
        "fade_in": true,
        "delay": true,
        "attack": true,
        "release": true,
        "gain": true
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    }
  },
  "patternProperties": {
    "^(x-|x_|_)|^notes$|^\\$comment$": {}
  },
  "$id": "https://github.com/kevstermcgee/RedEngine/schemas/voice.schema.json"
}
