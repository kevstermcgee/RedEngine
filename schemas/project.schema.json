{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Red Engine 2 game project",
  "description": "A game project's `game.json`. Generated by `red_engine2 schema` from src/content/; do not edit.",
  "type": "object",
  "properties": {
    "game": true,
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "engine": {
      "anyOf": [
        {
          "$ref": "#/$defs/Engine"
        },
        {
          "type": "null"
        }
      ]
    },
    "blueprints": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "maps": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "server": {
      "anyOf": [
        {
          "$ref": "#/$defs/Server"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "anyOf": [
        {
          "$ref": "#/$defs/Capabilities"
        },
        {
          "type": "null"
        }
      ]
    },
    "binary": {
      "type": [
        "string",
        "null"
      ]
    },
    "server_binary": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Engine": {
      "description": "The engine the game pins.",
      "type": "object",
      "properties": {
        "git": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    },
    "Server": {
      "description": "How `serve` runs the game.",
      "type": "object",
      "properties": {
        "map": {
          "type": [
            "string",
            "null"
          ]
        },
        "port": true,
        "spawn_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    },
    "Capabilities": {
      "description": "What the game declares it uses (`red_engine2 capabilities`).",
      "type": "object",
      "properties": {
        "presentation": {
          "type": [
            "string",
            "null"
          ]
        },
        "platforms": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "networking": {
          "type": [
            "string",
            "null"
          ]
        },
        "input": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "persistence": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "distribution": true
      },
      "additionalProperties": false,
      "patternProperties": {
        "^(x-|x_|_)|^notes$|^\\$comment$": {}
      }
    }
  },
  "patternProperties": {
    "^(x-|x_|_)|^notes$|^\\$comment$": {}
  },
  "$id": "https://github.com/kevstermcgee/RedEngine/schemas/project.schema.json"
}
