{
  "name": "new_game_2d",
  "description": "Task 5 and 6: a 2D browser game from the recommended starter to a published package: scaffold, verify, run it in a real headless browser, publish to a local site (wasm build, package, browser smoke, upload, check the copy). The shipping loop for a small game.",
  "steps": [
    {
      "id": "new-game",
      "kind": "build",
      "cmd": [
        "{RED}",
        "new-game",
        "{WORK}/dash",
        "--kind",
        "2d",
        "--name",
        "dash",
        "--engine-path",
        "{ENGINE}"
      ]
    },
    {
      "id": "describe",
      "kind": "discovery",
      "cmd": [
        "{RED}",
        "describe",
        "2d"
      ]
    },
    {
      "id": "verify",
      "kind": "verify",
      "cmd": [
        "{RED}",
        "verify",
        "{WORK}/dash/dash.game2d.json"
      ]
    },
    {
      "id": "web-verify",
      "kind": "ship",
      "cmd": [
        "{RED}",
        "web",
        "verify",
        "{WORK}/dash/dash.game2d.json"
      ],
      "timeout": 900
    },
    {
      "id": "publish",
      "kind": "ship",
      "cmd": [
        "{RED}",
        "publish",
        "{WORK}/dash/dash.game2d.json",
        "--site",
        "{WORK}/site",
        "--out",
        "{WORK}/publish"
      ],
      "timeout": 1200
    }
  ]
}
