{
 "meta": { "fps": 30, "duration": 4, "resolution": [960, 540] },
 "background": { "sky_top": "#8fc7ff", "sky_bottom": "#eef6ff" },
 "ambient": { "color": "#ffffff", "intensity": 0.5 },
 "camera": { "fov": 70, "position": [-4, 1.7, 0], "target": [0, 0.6, 0] },
 "lights": [{ "id": "lamp", "type": "point", "position": [0, 2.6, 0], "color": "#fff0d0", "intensity": 11, "range": 9 }],
 "zones": [{ "id": "room", "rect": [-5.88, -3.88, 5.88, 3.88], "y": 0, "kind": "room" }],
 "spawns": [{ "id": "start", "position": [-1.5, 0, 0], "yaw_deg": 90, "group": "solo" }],
 "vars": { "kicked": 0 },
 "rules": [
  {
   "id": "kick_far_crate",
   "when": { "after": 1 },
   "if": "players >= 2",
   "once": true,
   "do": [{ "impulse": { "object": "crate_far", "dir": [1, 0.3, 0], "speed": 4 } }, { "add": ["kicked", 1] }, { "emit": "kicked" }]
  }
 ],
 "checks": {
  "lint": { "max_errors": 0, "max_warnings": 0 },
  "sim": [
   {
    "name": "one bat swing shoves the dormant crate in front of the spawn",
    "spawn_group": "solo",
    "players": [{ "id": "p1", "character": "human", "spawn": "start" }],
    "script": [{ "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": -47, "attack": true, "seconds": 0.3 } }, { "player": "p1", "wait": 2 }],
    "expect": [{ "no_event": "kicked" }, { "not_ended": true }]
   },
   {
    "name": "a rule impulse shoves the far crate once two players are present",
    "spawn_group": "solo",
    "players": [{ "id": "p1", "character": "human", "spawn": "start" }, { "id": "p2", "character": "human", "spawn": "start" }],
    "script": [{ "player": "p1", "wait": 3 }],
    "expect": [{ "event": "kicked", "count": 1 }, { "var": "kicked", "eq": 1 }, { "not_ended": true }]
   }
  ]
 },
 "objects": [
  { "id": "floor", "type": "plane", "size": [12, 8], "position": [0, 0.01, 0], "material": { "color": "#c8c0b0", "roughness": 0.9 } },
  { "id": "ceiling", "type": "box", "size": [12, 0.2, 8], "position": [0, 2.9, 0], "material": { "color": "#e8e4dc" } },
  { "id": "wall_n", "type": "wall", "from": [-6, -4], "to": [6, -4], "height": 2.8, "thickness": 0.24 },
  { "id": "wall_s", "type": "wall", "from": [-6, 4], "to": [6, 4], "height": 2.8, "thickness": 0.24 },
  { "id": "wall_w", "type": "wall", "from": [-6, -4], "to": [-6, 4], "height": 2.8, "thickness": 0.24 },
  { "id": "wall_e", "type": "wall", "from": [6, -4], "to": [6, 4], "height": 2.8, "thickness": 0.24 },
  { "id": "crate_near", "type": "prop", "prop": "crate", "scale": 0.6, "position": [0, 0, 0], "material": { "color": "#4a7fb0" } },
  { "id": "crate_far", "type": "prop", "prop": "crate", "position": [3, 0, 2], "material": { "color": "#b07f4a" } }
 ]
}
