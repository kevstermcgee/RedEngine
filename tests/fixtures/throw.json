     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": 0, "seconds": 0.3 } },
     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": 0, "forward": 1, "seconds": 1.0 } },
     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": 0, "forward": 1, "interact": true, "seconds": 0.05 } },
     { "player": "p1", "wait": 3 }
    ],
    "expect": [{ "event": "drop", "count": 1 }, { "player": "p1", "near": [4.4, 0], "tol": 0.4 }, { "prop": "crate", "near": [6.9, 0.1], "tol": 0.8, "y": 0 }]
   },
   {
    "name": "sprint, release, stop: the crate keeps the sprint speed and lands about 4 m past the release point",
    "spawn_group": "solo",
    "players": [{ "id": "p1", "character": "human", "spawn": "tee" }],
    "script": [
     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": -45, "seconds": 0.2 } },
     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": -45, "interact": true, "seconds": 0.1 } },
     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": 0, "seconds": 0.3 } },
     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": 0, "forward": 1, "sprint": true, "seconds": 1.0 } },
     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": 0, "forward": 1, "sprint": true, "interact": true, "seconds": 0.05 } },
     { "player": "p1", "wait": 3 }
    ],
    "expect": [{ "event": "drop", "count": 1 }, { "player": "p1", "near": [8.4, 0], "tol": 0.4 }, { "prop": "crate", "near": [13.4, 0.6], "tol": 1.2 }]
   },
   {
    "name": "sprint, release, keep sprinting: the arc is the same, and a body that runs into the landed crate still pushes it",
    "spawn_group": "solo",
    "players": [{ "id": "p1", "character": "human", "spawn": "tee" }],
    "script": [
     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": -45, "seconds": 0.2 } },
     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": -45, "interact": true, "seconds": 0.1 } },
     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": 0, "seconds": 0.3 } },
     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": 0, "forward": 1, "sprint": true, "seconds": 1.0 } },
     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": 0, "forward": 1, "sprint": true, "interact": true, "seconds": 0.05 } },
     { "player": "p1", "hold": { "yaw_deg": 90, "pitch_deg": 0, "forward": 1, "sprint": true, "seconds": 1.0 } },
     { "player": "p1", "wait": 3 }
    ],
    "expect": [{ "event": "drop", "count": 1 }, { "player": "p1", "near": [16.4, 0], "tol": 0.4 }, { "prop": "crate", "near": [19.6, 0.7], "tol": 1.5 }]
   }
  ]
 },
