# Copy to /etc/red/server.env (systemd) or pass with `docker run --env-file`. Every value is optional.
RED_MAP=/opt/red/maps/main.json
RED_PORT=27015
RED_BIND=0.0.0.0
# Only spawn points in this group are used (a map can carry several: duel, solo, ...)
RED_SPAWN_GROUP=duel
# Print server statistics every N seconds (0 = never)
RED_STATS_SECS=60
# Seconds without a packet before a client is dropped (milliseconds)
RED_TIMEOUT_MS=3000
# Join key: clients must prove they know it (never sent; ADR 0028). Use a long random value: `red_server --key auto` prints one.
# RED_KEY=
# 1 = the lobby / countdown / round / results / rematch flow (a map's own "match" block does the same); the rest override its settings
# RED_LOBBY=1
# RED_MIN_PLAYERS=2
# RED_COUNTDOWN_SECS=5
# RED_ROUND_SECS=300
# RED_RESULTS_SECS=12
# RED_SCORE_TO_WIN=0
# 1 = open the UDP port on a home router with UPnP (renewed while running, removed on exit; useless in a container or on a VPS)
# RED_UPNP=0
