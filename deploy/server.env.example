# Copy to /etc/red/server.env (systemd) or pass with `docker run --env-file`. Every value is optional.
RED_MAP=/opt/red/maps/main.json
RED_PORT=27015
RED_BIND=0.0.0.0
# Only spawn points in this group are used (a map can carry several: duel, solo, ...)
RED_SPAWN_GROUP=duel
# Print server statistics every N seconds (0 = never)
RED_STATS_SECS=60
# Seconds without a packet before a client is dropped (milliseconds)
RED_TIMEOUT_MS=3000
