[Unit]
Description=Red Engine dedicated game server (QUIC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=red
WorkingDirectory=/opt/red
# RED_MAP, RED_PORT, RED_BIND, RED_SPAWN_GROUP, ... (see deploy/server.env.example); a missing file is fine (defaults apply)
# A service exists to be reached: public bind by default (the binary itself defaults to loopback); server.env may narrow it.
Environment=RED_BIND=0.0.0.0
# The server's identity (ADR 0044): `red_engine2 net-identity --out /etc/red/identity`, key readable by the red user only.
Environment=RED_TLS_CERT=/etc/red/identity/cert.pem RED_TLS_KEY=/etc/red/identity/key.pem
EnvironmentFile=-/etc/red/server.env
ExecStart=/usr/local/bin/red_server
Restart=on-failure
RestartSec=3
# SIGTERM is handled: clients are told, a --record trace is written
KillSignal=SIGTERM
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/red
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
