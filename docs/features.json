{
  "format": 1,
  "notes": "Which parts of the engine exist, who owns which file, and what must pass when a file changes. `red_engine2 features` lists it, `red_engine2 impact --git` turns a working tree into the exact commands to run, `red_engine2 features --check` (and tests/features_index.rs) keep it true: every listed file/suite/doc must exist and every source file must belong to a feature. tests: `lib:<module::path>` = library unit tests under that module, anything else = tests/<name>.rs. depends_on = features whose change can break this one.",
  "features": {
    "scene_format": {
      "summary": "The JSON scene language: schema, strict unknown-field errors, wall/fence sugar, prefabs, tracks and easing, colours.",
      "files": ["src/schema.rs", "src/strict.rs", "src/macros.rs", "src/prefabs.rs", "src/track.rs", "src/easing.rs", "src/color.rs", "assets/*.json", "examples/**", "SPEC.md"],
      "tests": ["lib:schema", "lib:strict", "lib:prefabs", "lib:macros", "lib:track", "examples_validate"],
      "commands": ["red_engine2 validate examples/test_lab.json"],
      "docs": ["SPEC.md", "docs/adr/0001-json-scenes-and-self-describing-cli.md", "docs/adr/0006-parse-time-expansion-for-sugar.md", "docs/adr/0019-strict-fields-versioning-and-json-envelope.md"]
    },
    "offline_renderer": {
      "summary": "GPU rendering to PNG/MP4: meshes, lighting, shaders, the humanoid and rat rigs, props, the offline `frame`/`render` commands.",
      "files": ["src/render.rs", "src/mesh.rs", "src/gpu.rs", "src/video.rs", "src/geometry.rs", "src/skeleton.rs", "src/characters.rs", "src/props.rs", "src/revolver.rs", "src/shaders/**"],
      "tests": ["lib:mesh", "lib:props", "lib:characters", "lib:skeleton"],
      "commands": ["red_engine2 frame examples/test_lab.json out/frame.png", "red_engine2 tour examples/test_lab.json out/tour.png"],
      "docs": ["docs/adr/0002-props-in-rust-prefabs-in-json.md", "docs/adr/0008-procedural-assets-only.md"],
      "depends_on": ["scene_format"]
    },
    "player_physics": {
      "summary": "One shared player movement, collision and reachable-ground rule used by the game, the server, client prediction and the map tools.",
      "files": ["src/player.rs", "src/collide.rs", "src/sim/player.rs"],
      "tests": ["lib:collide", "lib:player", "lib:sim::player", "house_walk", "test_lab"],
      "commands": ["red_engine2 verify examples/test_lab.json --no-views"],
      "docs": ["docs/adr/0003-one-physics-shared-by-game-and-tools.md", "docs/adr/0004-reachable-ground-height-for-floors.md", "docs/adr/0005-fixed-step-physics-with-camera-interpolation.md"],
      "depends_on": ["scene_format"]
    },
    "prop_physics": {
      "summary": "Rapier rigid-body props that stay dormant until touched; pick-up, drop, knock-over; exact hit shapes.",
      "files": ["src/physics/**", "src/hit.rs"],
      "tests": ["lib:physics", "lib:hit", "prop_physics", "melee_hits"],
      "docs": ["docs/adr/0012-rapier-prop-physics-dormant-until-disturbed.md", "docs/adr/0011-two-characters-and-exact-melee-hits.md"],
      "depends_on": ["player_physics"]
    },
    "combat_weapons": {
      "summary": "Bat and revolver: tick-based swings, cooldowns, hitscan, health, death and respawn, authoritative pick-up contention.",
      "files": ["src/weapons.rs", "src/sim/combat.rs", "src/sim/interact.rs"],
      "tests": ["lib:weapons", "lib:sim::combat", "lib:sim::interact", "interactions", "net_interactions"],
      "docs": ["docs/adr/0013-revolver-second-weapon-hitscan-infinite-ammo.md", "docs/adr/0022-authoritative-interactions-per-prop-acks-and-interest.md"],
      "depends_on": ["prop_physics", "sim_core"]
    },
    "sim_core": {
      "summary": "The headless, renderer-free simulation: fixed tick clock, scratch buffers, change tracking, entities, static props, the authoritative MatchSim, spawns, interest management.",
      "files": ["src/sim/mod.rs", "src/sim/clock.rs", "src/sim/scratch.rs", "src/sim/change.rs", "src/sim/components.rs", "src/sim/entities.rs", "src/sim/statics.rs", "src/sim/snapshot.rs", "src/sim/match_sim.rs", "src/sim/spawns.rs", "src/sim/interest.rs"],
      "tests": ["lib:sim", "alloc_budget", "alloc_sites", "test_lab", "net_interest"],
      "commands": ["cargo bench --bench sim", "red_engine2 perf examples/test_lab.json"],
