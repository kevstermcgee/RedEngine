  {
   "id": "clock",
   "when": {
    "every": 1
   },
   "do": [
    {
     "add": [
      "timeleft",
      -1
     ]
    }
   ]
  },
  {
   "id": "win",
   "when": {
    "every": 0.05
   },
   "if": "gems_left <= 0",
   "do": [
    {
     "end": "win"
    }
   ]
  },
  {
   "id": "lose",
   "when": {
    "every": 0.05
   },
   "if": "timeleft <= 0 && gems_left > 0",
   "do": [
    {
     "end": "lose"
    }
   ]
  }
 ],
