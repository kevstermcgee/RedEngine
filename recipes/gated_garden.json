      "id": "p1",
      "character": "human",
      "spawn": "spawn_a"
     }
    ],
    "script": [
     {
      "player": "p1",
      "walk": "-5,-3; 4,0; 8.8,0"
     }
    ],
    "expect": [
     {
      "event": "key",
      "count": 1
     },
     {
      "event": "gate_open",
      "count": 1
     },
     {
      "event": "victory",
      "count": 1
     },
     {
      "ended": "victory"
     }
    ]
   },
   {
    "name": "the gate stays shut without the key",
    "spawn_group": "solo",
    "players": [
     {
      "id": "p1",
      "character": "human",
      "spawn": "spawn_a"
     }
    ],
    "script": [
