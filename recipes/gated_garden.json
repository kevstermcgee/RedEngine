   "yaw_deg": 90,
   "group": "solo"
  }
 ],
 "vars": {
  "has_key": 0
 },
 "rules": [
  {
   "id": "take_key",
   "when": {
    "enter": {
     "object": "key",
     "pad": 0.3
    }
   },
   "once": true,
   "do": [
    {
     "set": [
      "has_key",
      1
     ]
    },
    {
     "hide": "key"
    },
    {
     "emit": "key"
    }
   ]
  },
  {
   "id": "gate_locked",
   "when": {
    "enter": {
     "object": "gate",
     "pad": 0.8
    }
   },
   "if": "has_key == 0",
   "do": [
    {
     "emit": "locked"
    }
   ]
  },
  {
   "id": "open_gate",
   "when": {
    "enter": {
     "object": "gate",
     "pad": 0.8
    }
   },
   "if": "has_key == 1",
   "once": true,
   "do": [
    {
     "deactivate": "gate"
    },
    {
     "emit": "gate_open"
    }
   ]
  },
  {
   "id": "sit_on_bench",
   "when": {
    "enter": {
     "zone": "bench"
    }
   },
   "do": [
    {
     "emit": "victory"
    },
    {
     "end": "victory"
    }
   ]
  }
 ],
 "phases": {
  "gate_open": [
   "open_gate"
  ]
 },
 "checks": {
  "lint": {
   "max_errors": 0,
   "max_warnings": 0
  },
  "reach": [
   {
    "to": [
     0,
     0
    ],
    "why": "courtyard"
   },
   {
    "to": [
     8,
     0
    ],
    "reachable": false,
    "why": "garden is sealed until the gate opens"
   },
   {
    "to": [
     8,
     0
    ],
    "phase": "gate_open",
    "why": "garden once the gate is open"
   }
  ],
  "walk": [
   {
    "name": "through the open gate to the bench",
    "phase": "gate_open",
    "path": "-8,0; 8.8,0",
    "ends_near": [
     8.8,
     0
    ],
    "tol": 0.4,
    "floor_y": 0
   }
  ],
  "objects": {
