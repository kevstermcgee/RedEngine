   "yaw_deg": 90,
   "group": "solo"
  }
 ],
 "vars": {
  "score": 0
 },
 "rules": [
  {
   "id": "take_coin_1",
   "when": {
    "enter": {
     "object": "coin_1",
     "pad": 0.3
    }
   },
   "once": true,
   "do": [
    {
     "add": [
      "score",
      1
     ]
    },
    {
     "hide": "coin_1"
    },
    {
     "emit": "coin"
    }
   ]
  },
  {
   "id": "take_coin_2",
   "when": {
    "enter": {
     "object": "coin_2",
     "pad": 0.3
    }
   },
   "once": true,
   "do": [
    {
     "add": [
      "score",
      1
     ]
    },
    {
     "hide": "coin_2"
    },
    {
     "emit": "coin"
    }
   ]
  },
  {
   "id": "take_coin_3",
   "when": {
    "enter": {
     "object": "coin_3",
     "pad": 0.3
    }
   },
   "once": true,
   "do": [
    {
     "add": [
      "score",
      1
     ]
    },
    {
     "hide": "coin_3"
    },
    {
     "emit": "coin"
    }
   ]
  },
  {
   "id": "exit_locked",
   "when": {
    "enter": {
     "zone": "exit"
    }
   },
   "if": "score < 3",
   "do": [
    {
     "emit": "locked"
    }
   ]
  },
  {
   "id": "exit_open",
   "when": {
    "enter": {
     "zone": "exit"
    }
   },
   "if": "score >= 3",
   "do": [
    {
     "emit": "victory"
    },
    {
     "end": "victory"
    }
   ]
  },
  {
   "id": "trap",
   "when": {
    "enter": {
     "zone": "trap"
    }
   },
   "do": [
    {
     "emit": "ouch"
    },
    {
     "teleport": "spawn_a"
    }
   ]
  }
 ],
