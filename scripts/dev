#!/usr/bin/env bash
# scripts/dev — one entry point for building, testing and running Red Engine 2 from ANY shell, ANY cwd, ANY OS.
#
# It hides the environment: finds cargo (sourcing ~/.local/toolchain/env.sh or ~/.cargo/env if present), always
# runs from the repo root, never prints colour codes, puts a timeout on everything, and prints how long each step took.
#
#   scripts/dev doctor                 what toolchain / binaries / git state does this machine have? (`doctor-full`: the engine's own probe)
#   scripts/dev iterate [--check-only] [--headless]   the edit loop: only what changed since HEAD, fmt + type-check + focused unit tests, seconds. NEVER
#                                      verification: it says so, never escalates, and is stamped so no other tier accepts it (alias of `affected --partial`).
#   scripts/dev affected [--quick|--full]  verify ONLY what your change can affect (alias: check). --quick = owning features, default = plus dependents
#                                      (before "done"), --full = CI (before pushing); boundary files escalate by themselves. The change set is everything since the
#                                      merge base with origin/main (use `iterate`, or `--base HEAD`, for just your last edit). A green run is remembered by
#                                      file content, base commit, feature set and toolchain: asking again with nothing edited is free.
#   scripts/dev preflight [--full] [--fix]   repository bookkeeping (~1 s). With a binary older than your edits it runs the tree-only checks and names the two it
#                                      skipped; --full builds first and checks everything.
#   scripts/dev context <feature|file|words>   a 5-15 KB work packet for one change (files, public API, tests, ADR pointers)
#   scripts/dev fast                   unit tests only (seconds): `cargo test --lib`
#   scripts/dev test [filter]          the whole suite (or tests whose name matches filter); prints a summary, full log in out/logs/
#   scripts/dev build [--headless]     debug build of the CLI, server, bot (and the game unless --headless)
#   scripts/dev red <args...>          run the red_engine2 CLI (builds it first): `scripts/dev red lint maps/x.json`
#   scripts/dev verify <scene> [...]   `red_engine2 verify` (extra args pass through: --only walk[1], --no-views)
#   scripts/dev walk <scene> [...]     `red_engine2 walk` (--auto --from X,Z --to X,Z, --explain out.png)
#   scripts/dev server <scene> [...]   the headless authoritative server (UDP 27015)
#   scripts/dev ci                     what CI runs (fmt, clippy -D warnings, tests, headless build)
#   scripts/dev status [...]           `red_engine2 status` (handoff: what is done / in flight / next)
#
# Env: RED_TIMEOUT=seconds per command (default 900), RED_PROFILE=debug|release|fast (default debug; the dev profile is
# already opt-level 1 so it is fast enough for maps and tests: measured, a one-line edit is 2-4 s to type-check, 4 s to rebuild the lib tests, against
# 3+ minutes for a release build; never use --release to iterate). CARGO_TARGET_DIR is honoured (put build output on another drive).
# RED_WAIT=1 queues behind another heavy job (build/test/affected/ci) instead of refusing: two at once on a 4-core box slow both.
set -u
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/.." && pwd)"
cd "$ROOT" || exit 2

for f in "$HOME/.local/toolchain/env.sh" "$HOME/.cargo/env"; do
  [ -f "$f" ] && . "$f"
done
case ":$PATH:" in *":$HOME/.cargo/bin:"*) ;; *) PATH="$HOME/.cargo/bin:$PATH" ;; esac
export PATH CARGO_TERM_COLOR=never RUST_BACKTRACE="${RUST_BACKTRACE:-1}"

TARGET_DIR="${CARGO_TARGET_DIR:-$ROOT/target}"
PROFILE="${RED_PROFILE:-debug}"
case "$PROFILE" in debug) PFLAG="" ;; release) PFLAG="--release" ;; *) PFLAG="--profile $PROFILE" ;; esac   # fast = [profile.fast] in Cargo.toml
TMO="${RED_TIMEOUT:-900}"

run() { # run <label> <cmd...>: timeout + elapsed
  local label="$1"; shift
  local t0=$SECONDS rc
  if command -v timeout >/dev/null 2>&1; then timeout "$TMO" "$@"; else "$@"; fi
  rc=$?
  if [ $rc -eq 124 ]; then echo "dev: $label TIMED OUT after ${TMO}s (raise RED_TIMEOUT)" >&2; fi
  echo "dev: $label finished in $((SECONDS - t0))s (exit $rc)" >&2
  return $rc
}

logged() { # logged <name> <cmd...>: full output to out/logs/<name>.log, print only a summary (a whole suite is thousands of lines)
  local name="$1"; shift
  mkdir -p out/logs
  local log="out/logs/$name.log"
  run "$name" "$@" > "$log" 2>&1
  local rc=$?
  local tally
  tally="$(grep -E '^test result' "$log" | awk '{p+=$4; f+=$6; i+=$8} END {print p+0 " passed, " f+0 " failed, " i+0 " ignored"}')"
  case "$tally" in "0 passed, 0 failed, 0 ignored") ;; *) echo "$name: $tally" ;; esac
  if [ $rc -ne 0 ]; then
    grep -E '^(test .* FAILED|error(\[|:)|.*panicked at|failures:$)' "$log" | head -40
    tail -n 5 "$log" | sed 's/^/  | /'
  else
    [ -n "$tally" ] || tail -n 3 "$log"
  fi
  echo "$name: full log in $log (exit $rc)"
  return $rc
}

need_cargo() {
  command -v cargo >/dev/null 2>&1 || {
    echo "dev: cargo not found. Install Rust (https://rustup.rs) or point ~/.local/toolchain/env.sh at it." >&2
    exit 127
  }
}

needs_build() { # binary name + build mode: missing, forced, mode-changed, or older than an input
  local exe="$TARGET_DIR/$PROFILE/$1"
  local mode="${2:-default}" stamp="$TARGET_DIR/$PROFILE/.red-dev-$1.mode"
  [ -f "$exe" ] || exe="$exe.exe"
  [ "${RED_REBUILD:-0}" = "1" ] || [ ! -f "$exe" ] && return 0
  [ -f "$stamp" ] || return 0
  [ "$(cat "$stamp")" != "$mode" ] && return 0
  local f d
  for f in "$ROOT/Cargo.toml" "$ROOT/Cargo.lock" "$ROOT/build.rs"; do [ -f "$f" ] && [ "$f" -nt "$exe" ] && return 0; done
  for d in "$ROOT/src" "$ROOT/assets"; do [ -d "$d" ] && [ -n "$(find "$d" -type f -newer "$exe" -print -quit)" ] && return 0; done
  return 1
}

# The files whose *logic* decides what `affected`, `context` and `preflight` say. The feature index (docs/features.json) is deliberately NOT here: the tools read it
# from the checkout at run time, so editing it never needs a rebuild and a prebuilt binary never plans with a stale copy.
PLANNER_LOGIC="src/tools/affected.rs src/tools/features.rs src/tools/context.rs src/tools/symbols.rs src/crypto.rs src/cli/args.rs src/cli/analyze.rs src/cli/info.rs"
PREFLIGHT_LOGIC="src/tools/preflight.rs src/tools/adr.rs src/tools/features.rs src/tools/status.rs src/cli/repo.rs src/cli/args.rs"

logic_fresh() { # logic_fresh <exe> <file...>: true when the binary exists and none of those files is newer than it
  local exe="$1" f; shift
  [ -f "$exe" ] && [ "${RED_REBUILD:-0}" != "1" ] || return 1
  for f in "$@"; do [ -f "$f" ] && [ "$f" -nt "$exe" ] && return 1; done
  return 0
}

planner() { # the CLI for `affected`/`context`: a stale binary plans identically unless the planner's own logic changed (it reads the index at run time)
  local exe="$TARGET_DIR/$PROFILE/red_engine2"
  [ -f "$exe" ] || exe="$exe.exe"
  # shellcheck disable=SC2086
  if logic_fresh "$exe" $PLANNER_LOGIC; then echo "$exe"; return; fi
  cli
}

heavy_lock() { # one heavy job at a time: two builds/test runs on a 4-core box make both slower, and the second one used to run anyway
  command -v flock >/dev/null 2>&1 || return 0
  mkdir -p "$TARGET_DIR" 2>/dev/null
  exec 9>"$TARGET_DIR/.red-dev-heavy.lock"
  if ! flock -n 9; then
    if [ "${RED_WAIT:-0}" = "1" ]; then
      echo "dev: another heavy job is running; queueing behind it (RED_WAIT=1)" >&2
      flock 9
    else
      echo "dev: another heavy job (build, test, affected, iterate or ci) is running in this target directory; not starting a second one. Wait for it, or RED_WAIT=1 to queue." >&2
      exit 75
    fi
  fi
}

cli() { # path of the CLI binary, building it if needed
  need_cargo
  if needs_build red_engine2 default; then
    run "build red_engine2" cargo build $PFLAG --bin red_engine2 --quiet || exit $?
    printf '%s' default > "$TARGET_DIR/$PROFILE/.red-dev-red_engine2.mode"
  fi
  local exe="$TARGET_DIR/$PROFILE/red_engine2"
  [ -x "$exe" ] || exe="$exe.exe"
  echo "$exe"
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  doctor)
    echo "repo      $ROOT"
    echo "os        $(uname -sm 2>/dev/null || echo unknown)"
    if command -v cargo >/dev/null 2>&1; then echo "cargo     $(cargo --version)"; echo "rustc     $(rustc --version)"; else echo "cargo     NOT FOUND (install Rust: https://rustup.rs)"; fi
    for b in red_engine2 red_server red_bot re2; do
      p="$TARGET_DIR/$PROFILE/$b"; { [ -f "$p" ] || [ -f "$p.exe" ]; } && echo "built     $b ($PROFILE)" || echo "not built $b"
    done
    command -v git >/dev/null 2>&1 && echo "git       $(git rev-parse --abbrev-ref HEAD 2>/dev/null) @ $(git rev-parse --short HEAD 2>/dev/null), $(git status --short 2>/dev/null | wc -l | tr -d ' ') changed file(s)"
    command -v python3 >/dev/null 2>&1 && echo "python3   $(python3 --version 2>&1)" || echo "python3   not found (only needed for benches/check.py and mcp_server.py)"
    [ -f STATUS.md ] && echo "status    STATUS.md exists: run 'scripts/dev status'" || echo "status    no STATUS.md yet: 'scripts/dev status --init'"
    ;;
  fast)   need_cargo; heavy_lock; logged unit-tests cargo test $PFLAG --lib "$@" ;;
  test)   need_cargo; heavy_lock; logged tests cargo test $PFLAG --no-fail-fast "$@" ;;
  build)
    need_cargo; heavy_lock
    if [ "${1:-}" = "--headless" ]; then
      run "headless build" cargo build $PFLAG --no-default-features --bin red_engine2 --bin red_server --bin red_bot
    else
      run "build" cargo build $PFLAG --bin red_engine2 --bin red_server --bin red_bot --bin re2
    fi ;;
  red)    exe="$(cli)" || exit $?; exec "$exe" "$@" ;;
  verify) exe="$(cli)" || exit $?; run "verify" "$exe" verify "$@" ;;
  walk)   exe="$(cli)" || exit $?; run "walk" "$exe" walk "$@" ;;
  status) exe="$(cli)" || exit $?; exec "$exe" status "$@" ;;
  server)
    need_cargo
    if needs_build red_server headless; then
      run "build red_server" cargo build $PFLAG --no-default-features --bin red_server --quiet || exit $?
      printf '%s' headless > "$TARGET_DIR/$PROFILE/.red-dev-red_server.mode"
    fi
    exe="$TARGET_DIR/$PROFILE/red_server"; [ -x "$exe" ] || exe="$exe.exe"
    exec "$exe" --map "$@" ;;
  affected|check|iterate)
    need_cargo
    case " $* " in *" --dry-run "*) ;; *) heavy_lock ;; esac
    exe="$(planner)" || exit $?
    if [ "$cmd" = iterate ]; then exec "$exe" affected --partial "$@"; fi
    exec "$exe" affected "$@" ;;
  preflight)
    need_cargo
    full=0; args=()
    for a in "$@"; do if [ "$a" = "--full" ]; then full=1; else args+=("$a"); fi; done
    exe="$TARGET_DIR/$PROFILE/red_engine2"; [ -f "$exe" ] || exe="$exe.exe"
    # shellcheck disable=SC2086
    if [ $full -eq 1 ] || ! logic_fresh "$exe" $PREFLIGHT_LOGIC; then exe="$(cli)" || exit $?; exec "$exe" preflight ${args[@]+"${args[@]}"}; fi
    if needs_build red_engine2 default; then exec "$exe" preflight --tree ${args[@]+"${args[@]}"}; fi
    exec "$exe" preflight ${args[@]+"${args[@]}"} ;;
  context) need_cargo; exe="$(planner)" || exit $?; exec "$exe" context "$@" ;;
  ci)     need_cargo; heavy_lock; logged ci bash scripts/ci.sh ;;
  doctor-full) exe="$(cli)" || exit $?; "$exe" doctor ;;
  help|-h|--help) sed -n '2,25p' "$0" ;;
  *) echo "dev: unknown command '$cmd' (try: scripts/dev help)" >&2; exit 2 ;;
esac
